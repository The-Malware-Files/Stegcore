# Stegcore-specific configuration for the baseline git hooks.
# Sourced as plain shell by .githooks/pre-commit and .githooks/pre-push.

# Future-version gate: refuse any v4.1+/v5+/etc. mention in public docs.
# The roadmap is gitignored so references there are unaffected.
BLOCK_FUTURE_VERSIONS_REGEX='\bv?[5-9]\.[0-9]+|\bv?4\.[1-9][0-9]*'

# British English gate — on by default.
BRE_ENABLED=1

# Supply-chain + workflow security gates — on by default.
SUPPLY_CHAIN_ENABLED=1
WORKFLOW_SECURITY_ENABLED=1

# Stegcore's Tauri host crate has libsoup/GTK/webkit2gtk system deps that
# aren't always on a dev machine; CI covers the workspace, the local
# pre-push gate is scoped to the engine + core + cli crates where most
# changes land.
CLIPPY_PACKAGES='-p stegcore-engine -p stegcore-core -p stegcore-cli'

# Sandbox dirs treated like private/.
PRIVATE_DIRS='private private-* sandbox-* lab-*'

# Heavy-work routing (added 2026-09-15). scripts/hooks/heavy-run.sh was already
# here and dispatching to atlas correctly, but atlas held only private/ and no
# source, so every dispatched build ran in an empty tree and the only working
# answer left was HEAVY_GATE_BYPASS=1. Naming the sync wrapper here is what lets
# the gate offer a route that actually works.
HEAVY_BUILD_SYNC='scripts/sync-to-atlas.sh'

# Toolchain paths this project publishes deliberately (operator, 2026-09-15).
#
# `private-remote-gate.sh` treats the whole hook toolchain as private unless a
# project NAMES what it publishes. That is ADR 67 applied to a path list: config
# may say what is checked, never whether, so omission cannot quietly publish
# anything and the decision has to be visible in review.
#
# Nearly all of this is already on the public remote and has been for months;
# declaring it makes an inherited state into a stated one. The only path this
# newly publishes is `.githooks/promotion-gate.sh`, which mentions
# `private/reviews/` and `private/for-hephaestus.md` by name. That discloses that
# a private reviews directory and a planning file exist, which the already-public
# PRIVATE_DIRS line above announces anyway. The contents stay private; only the
# gate that checks for them is public, and a gate is more useful public.
PUBLISHED_TOOLCHAIN='.githooks .baseline-hook-config .baseline-hook-allow .baseline-version .claude CLAUDE.md AGENTS.md scripts/hooks'

# Private-material push gate (added 2026-07-26). Deny-first: a remote is public
# unless named here, so private/ and the operator-state files cannot reach it.
# origin is the forgejo hub; github is PUBLIC.
PRIVATE_REMOTE_GATE_ENABLED=1
PRIVATE_REMOTES='origin'

# Invariant deterministic gate. Runs the shared `invariant` crate's pure checks
# on every push. The crate dispatches per project, so a repo only runs the
# checks that apply to it.
#
# Enabled fleetwide on 2026-07-26 after the findings it had been silently
# accumulating were actually fixed rather than suppressed: test fixtures marked
# per line, dokima's 16 missing licence attributions added, and its six
# watchdogs that genuinely need root carrying a written exemption instead of a
# User= line that would have made them fail quietly.
INVARIANT_GATE_ENABLED=1

# Multi-persona review gate (baseline Section 25). Adopted 2026-07-27: the
# twelve-persona roster is recorded in CLAUDE.md A8. With this set, the
# SessionStart hook stops printing the bootstrap block and starts counting
# commits since the last artefact in private/reviews/.
PANEL_GATE_ENABLED=1
