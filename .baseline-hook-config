# Stegcore-specific configuration for the baseline git hooks.
# Sourced as plain shell by .githooks/pre-commit and .githooks/pre-push.

# Future-version gate: refuse any v4.1+/v5+/etc. mention in public docs.
# The roadmap is gitignored so references there are unaffected.
BLOCK_FUTURE_VERSIONS_REGEX='\bv?[5-9]\.[0-9]+|\bv?4\.[1-9][0-9]*'

# British English gate — on by default.
BRE_ENABLED=1

# Supply-chain + workflow security gates — on by default.
SUPPLY_CHAIN_ENABLED=1
WORKFLOW_SECURITY_ENABLED=1

# Stegcore's Tauri host crate has libsoup/GTK/webkit2gtk system deps that
# aren't always on a dev machine; CI covers the workspace, the local
# pre-push gate is scoped to the engine + core + cli crates where most
# changes land.
CLIPPY_PACKAGES='-p stegcore-engine -p stegcore-core -p stegcore-cli'

# Sandbox dirs treated like private/.
PRIVATE_DIRS='private private-* sandbox-* lab-*'

# Heavy-work routing (added 2026-09-15). scripts/hooks/heavy-run.sh was already
# here and dispatching to atlas correctly, but atlas held only private/ and no
# source, so every dispatched build ran in an empty tree and the only working
# answer left was HEAVY_GATE_BYPASS=1. Naming the sync wrapper here is what lets
# the gate offer a route that actually works.
HEAVY_BUILD_SYNC='scripts/sync-to-atlas.sh'

# Toolchain paths this project publishes deliberately (operator, 2026-09-15).
#
# `private-remote-gate.sh` treats the whole hook toolchain as private unless a
# project NAMES what it publishes. That is ADR 67 applied to a path list: config
# may say what is checked, never whether, so omission cannot quietly publish
# anything and the decision has to be visible in review.
#
# Nearly all of this is already on the public remote and has been for months;
# declaring it makes an inherited state into a stated one. The only path this
# newly publishes is `.githooks/promotion-gate.sh`, which mentions
# `private/reviews/` and `private/for-hephaestus.md` by name. That discloses that
# a private reviews directory and a planning file exist, which the already-public
# PRIVATE_DIRS line above announces anyway. The contents stay private; only the
# gate that checks for them is public, and a gate is more useful public.
# NAMED FILES, NOT DIRECTORIES. A directory here publishes whatever lands in
# it later, without anybody deciding so, which is the opposite of a declaration.
# `.githooks` and `scripts/hooks` are gone from this line because they now
# contain no published file at all: the installed gates were untracked on
# 2026-09-27, and the gate's own listing showed both directories covering
# nothing while still standing as open-ended permissions.
PUBLISHED_TOOLCHAIN='.baseline-hook-config .baseline-hook-allow .baseline-version .claude/agents/weekly-dependency-audit.md CLAUDE.md AGENTS.md'

# Private-material push gate (added 2026-07-26). Deny-first: a remote is public
# unless named here, so private/ and the operator-state files cannot reach it.
# origin is the forgejo hub; github is PUBLIC.
# PRIVATE_REMOTE_GATE_ENABLED was here and did nothing. The key was removed
# from the code and from the gate's own header on 2026-08-11, because a header
# advertising a disable switch that does not exist is the worst of both: a
# reader looking for the escape hatch finds one, sets it, and believes the gate
# is off when it is not. Per ADR 67, config says what is checked and never
# whether. The private-remote gate has no off switch by design; the only bypass
# is SKIP_PRIVATE_REMOTE_GATE=1 in the environment, and it expects a reason.
PRIVATE_REMOTES='origin'

# Invariant deterministic gate. Runs the shared `invariant` crate's pure checks
# on every push. The crate dispatches per project, so a repo only runs the
# checks that apply to it.
#
# Enabled fleetwide on 2026-07-26 after the findings it had been silently
# accumulating were actually fixed rather than suppressed: test fixtures marked
# per line, dokima's 16 missing licence attributions added, and its six
# watchdogs that genuinely need root carrying a written exemption instead of a
# User= line that would have made them fail quietly.
INVARIANT_GATE_ENABLED=1

# Multi-persona review gate (baseline Section 25). Adopted 2026-07-27: the
# twelve-persona roster is recorded in CLAUDE.md A8. With this set, the
# SessionStart hook stops printing the bootstrap block and starts counting
# commits since the last artefact in private/reviews/.
PANEL_GATE_ENABLED=1

# The two remotes carry the SAME tree, and that is the point.
#
# They did not always. `origin`, the forgejo hub, tracked the private/ tree as
# well: 115 paths the public branch ignores. Both remotes called the branch
# `dev`, so `git merge origin/dev` looked like an ordinary catch-up and
# destroyed 101 files on 2026-09-16, because the merge wrote the ignored files
# and the abort deleted them.
#
# A DISTINCT_TREE_BRANCHES knob sat here, naming a `private-tree` branch so the
# two could not be confused. It was the wrong fix: it preserved the odd shape
# and taught every future reader a special case. The private tree is its own
# git repository and its own Syncthing folder, so the hub branch never needed
# to carry it. Both remotes are now plain mirrors (operator decision,
# 2026-09-21), and there is nothing left to tell apart.

# ── The operator's signature on his own source (2026-09-23) ─────────────────
#
# Two lines near the top of every source file, in that file's comment syntax.
# The values live here rather than in the gate, so the alias can differ per
# project and changing the words later is a config edit rather than a rewrite
# of every file.
#
# Enforced on the OPERATOR'S COMMITS ONLY, matched on committer email. That is
# not politeness: it is what keeps a personal signature from becoming a
# requirement imposed on a contributor. Both addresses are listed because he
# commits under both, and listing one would silently exempt every commit made
# under the other, which is the failure that looks exactly like the gate
# working.
#
# Coverage climbs by a ratchet rather than a sweep: a floor that may never fall,
# a radius (a touched directory must be whole) and a quota of cold files per
# commit. Rewriting every file in one pass would be one enormous diff that
# buries real changes and that nobody reviews.
SOURCE_HEADER_ENABLED=1
SOURCE_HEADER_AUTHOR='Daniel Iwugo'
SOURCE_HEADER_COMMENT='Christ is King'
SOURCE_HEADER_EMAILS='daniel@themalwarefiles.com 121883945+elementmerc@users.noreply.github.com'

# The versioned surface, stated rather than auto-discovered.
#
# CLAUDE.md A4 defines a release as bumping SIX declarations: the three
# workspace crate manifests, the Tauri crate, the Tauri config and the frontend
# package. `stegcore-ops` is listed too because it already tracks the release
# version and dropping it from the gate would stop anyone noticing if it stopped.
#
# `crates/detego-ml` is deliberately ABSENT. It is a new crate at 0.1.0, which
# is its own semantic version rather than a stale copy of the product's: it has
# its own workspace root, its own CI job and its own coverage gate, and it is a
# candidate for separate publication. Auto-discovery could not know that and
# read the disagreement as drift, which blocked a push. If the decision ever
# changes and it should track the product version, add it here and bump it in
# the same commit.
VERSION_FILES=(crates/engine/Cargo.toml crates/core/Cargo.toml crates/cli/Cargo.toml crates/stegcore-ops/Cargo.toml src-tauri/Cargo.toml src-tauri/tauri.conf.json frontend/package.json)
