# Supply-chain cooldown for npm. Copy this into a project root as .npmrc.
#
# ── THE COOLDOWN ───────────────────────────────────────────────────────────
#
# minimumReleaseAge delays installation of any package version younger than
# the window below. Most compromised package versions are caught and pulled
# within hours to a few days, so a cooldown means a routine `npm install`
# never picks up a version during that danger window.
#
# 21 days (operator, 2026-09-18, raised from 7). CISA's recommended floor is
# 7 days; three weeks buys a much wider margin and costs nothing on a fleet
# where dependency updates are not urgent.
#
# ── THE KEY NAME AND THE UNIT, BOTH MEASURED ON 2026-09-25 ─────────────────
#
# This said `minimumReleaseAge=30240` until then, and it did NOTHING. npm
# 11.19.1 does not know that key: it prints `Unknown project config
# "minimumReleaseAge"` into the install output and carries on. Proven rather
# than reasoned: a fresh install under the old line fetched hyperframes 0.8.74
# THREE HOURS after that version was published, which is precisely the window
# the cooldown exists to sit out.
#
# The key npm actually reads is `min-release-age`, and it is in DAYS, not
# minutes. The old value of 30240 was 21 days expressed in minutes, so with
# the correct key it would have meant 30,240 days: npm computed a cutoff of
# 1943 and refused every package on the registry.
#
# Both halves were wrong in a way that fails silently in opposite directions,
# one permitting everything and one permitting nothing. Verified working: with
# `min-release-age=21`, npm refused hyperframes 0.8.74 and installed 0.8.27,
# the newest version older than the window.
min-release-age=21

# ── THE OVERRIDE, WHICH IS NOT OPTIONAL ────────────────────────────────────
#
# A blanket cooldown blocks the CURE as well as the disease. When a CVE lands
# and the fix ships today, three weeks of waiting is three weeks of running
# the vulnerable version, and a control that cannot be overridden for a
# security patch is one somebody disables entirely on the day it matters.
#
# So name the package here, with the advisory and the date, and remove it
# once the window has passed. The list is the audit trail: an entry with no
# reason beside it is an entry to challenge.
#
#   min-release-age-exclude[]=some-package   # GHSA-xxxx, added 2026-09-18
#
# THE KEY NAME HERE WAS ALSO WRONG until 2026-09-25. It read
# `minimumReleaseAgeExclude[]`, which npm does not know, so the documented
# escape hatch did nothing at all. That is the worse half of the same bug the
# block above describes: a cooldown that cannot be overridden for a security
# patch is one somebody switches off entirely on the day it matters, and this
# file was offering an override that would have failed silently at exactly that
# moment. Confirmed against npm 11.19.1: `npm config ls -l` lists
# `min-release-age-exclude` and knows nothing by the old name.
#
# (Currently empty. Add entries above this line.)

# ── THE REST ───────────────────────────────────────────────────────────────
#
# Refuse to run install-time lifecycle scripts by default. Malicious packages
# overwhelmingly use postinstall as the execution vector. Turn scripts back on
# per-package only when genuinely needed.
ignore-scripts=true

# Fail the install if the lockfile and manifest disagree, instead of silently
# rewriting the lockfile.
prefer-offline=true
fund=false
audit-level=moderate

# ── A WARNING THAT COST AN AFTERNOON TO EARN ───────────────────────────────
#
# **minimumReleaseAge needs npm 11.10.0 or newer, and an older npm IGNORES IT
# SILENTLY.** It is an unknown config key to npm 9 and 10: no error, no
# warning, `npm config get minimumReleaseAge` simply answers `undefined`, and
# the install proceeds with no cooldown at all while this file sits in the
# repository looking like a control.
#
# Measured 2026-09-18: every machine on this fleet ran npm 9.2.0, so this
# setting protected nothing anywhere, in a file whose whole purpose is to
# protect something.
#
# `scripts/check-supply-chain-cooldown.sh` exists so that cannot be true
# quietly again. Run it, or let the gate ladder run it.
