#!/usr/bin/env bash
#
# pre-commit: secret-leak prevention.
#
# Scans only the staged additions (added lines in the staged diff), so
# clean files and historical blobs are never re-scanned. Blocks the
# commit if a line looks like a credential, or if a staged file is itself
# a key/secret file by name.
#
# Implements Section 13 of the engineering baseline.
#
# Install:  ../hooks/install.sh   (run from inside the project repo)
# Bypass:   git commit --no-verify   (last resort; recorded by commit-msg)
#
# False positive? Add a precise exception to .baseline-hook-allow in the
# repo root, one extended-regex per line, with a comment explaining why.

set -eu

RED=$(tput setaf 1 2>/dev/null || true)
YELLOW=$(tput setaf 3 2>/dev/null || true)
BOLD=$(tput bold 2>/dev/null || true)
RESET=$(tput sgr0 2>/dev/null || true)

# ── Baseline config loading (parsed, never executed) ────────────────────────
#
# `.baseline-hook-config` used to be `source`d. That handed arbitrary shell to
# anyone who could land that file in the repo, executed on the developer's own
# machine on every commit and every push. In a repo that takes outside
# contributions a documentation-shaped pull request was a code-execution hole.
#
# The grammar below is deliberately tiny and covers every shape the existing
# project configs use:
#
#     NAME=value        NAME='literal'    NAME="expanded $OTHER_KEY"
#     NAME=(a b c)      NAME=(            # one element per line
#                         'regex with ) inside'
#                       )
#
# Quoting follows shell rules, because the configs rely on them: a
# single-quoted value is literal, an unquoted or double-quoted value may
# reference an earlier key as $NAME or ${NAME}. Only names already assigned by
# this same file are substituted, so there is no environment leakage. There is
# no command substitution, no globbing and no word splitting beyond the array
# tokeniser: `$(...)` and backticks are data, because nothing is ever executed.
#
# A line the grammar does not accept is refused loudly. A config that silently
# stopped applying is worse than one that fails.

# Names that must never be assignable from a project file, because they change
# how this shell itself behaves. Everything else is allowed: the security
# property comes from never executing the file, not from enumerating knobs, and
# an allowlist that gates assignment would silently drop a real setting the day
# the baseline gains a new one.
BHC_BLOCKED_KEYS="
PATH IFS BASH_ENV ENV CDPATH LD_PRELOAD LD_LIBRARY_PATH SHELLOPTS BASHOPTS
PS1 PS2 PS4 PROMPT_COMMAND GLOBIGNORE HISTFILE FUNCNAME
BHC_BLOCKED_KEYS BHC_KNOWN_KEYS BHC_EXEC_KEYS
"

# Knobs whose VALUE reaches an exec or a build. The NAME is harmless, so a
# denylist of dangerous names never catches these: `INVARIANT_BIN=./evil.sh` is
# a documented, allowlisted knob used exactly as designed, and pre-push runs it.
# Demonstrated end to end on 2026-07-26 (arbitrary code execution as the operator
# on `git push`), which is why this is a separate list rather than more entries
# on the one above: the two lists answer different questions. BLOCKED asks "may
# this name be assigned at all"; EXEC asks "may a repo choose this value".
#
# These stay settable from the ENVIRONMENT, where the operator sets them, and are
# refused only from the parsed file, which any repo can ship.
#
# CLIPPY_PACKAGES and STALE_VERSION_CARGO_PATH are deliberately NOT here. Both
# are in live use, and neither escalates: clippy already compiles the repo's own
# build.rs whenever it runs, so a repo that can set them can already run code by
# the same path with or without the knob.
BHC_EXEC_KEYS="
INVARIANT_BIN INVARIANT_REPO PRECOMMIT_CLIPPY_DIR
"

# The two names above are the load-bearing ones and were missing until
# 2026-07-26. Without them the blocklist could disarm itself:
#
#     BHC_BLOCKED_KEYS=          <- allowed, because it was not on its own list
#     PATH=/tmp/attacker         <- now allowed, because the list is empty
#
# and every command the hook runs afterwards (git, cargo, grep) resolves through
# an attacker-controlled directory. Demonstrated end to end before fixing: a
# fake `git` on that PATH executed.
#
# A blocklist that can be edited by the thing it is guarding against is not a
# blocklist. The general rule this encodes: any name the parser's own security
# decisions read must be unassignable from the file being parsed.
#
# `_BHC_ELEMS` and `_BHC_CLOSED` are the scanner's scratch variables. They are
# reset before every use, so assigning them was measured to be harmless, and
# they are listed anyway: the invariant worth having is the flat one, "nothing
# the parser itself uses can be set by the file it is parsing", because that
# survives someone later using the scratch variables differently.

# Known baseline knobs. Used only to flag a likely typo; an unlisted name is
# still assigned, with a warning, so a newer config on an older hook keeps
# working.
BHC_KNOWN_KEYS="
AGPL_HEADER_ENABLED AGPL_HEADER_SPDX
BLOCK_FUTURE_VERSIONS_ENABLED BLOCK_FUTURE_VERSIONS_PATHS BLOCK_FUTURE_VERSIONS_REGEX
BLOCK_STALE_VERSION_REF_ENABLED BLOCK_STALE_VERSION_REF_PATHS
BRE_ENABLED BRE_EXEMPT_PATHS
CLIPPY_PACKAGES CODENAME_ENABLED
DOC_INJECTION_EXEMPT_PATHS
EMDASH_ENABLED EMDASH_EXEMPT_PATHS
IP_ALLOWLIST_PATHS IP_FORBIDDEN_REGEX IP_FORBIDDEN_REGEX_CI IP_HYGIENE_ENABLED
IP_PUBLISHABLE_LEGIT_PATTERNS IP_PUBLISHABLE_PATHS
LLM_TELLS_ENABLED
PANEL_GATE_ENABLED
PRECOMMIT_CLIPPY_DIR PRECOMMIT_CLIPPY_ENABLED
PRIVATE_DIRS PROTECTED_BRANCH_MODE
PRIVATE_REMOTE_GATE_ENABLED PRIVATE_REMOTES PRIVATE_PATHS
INVARIANT_GATE_ENABLED INVARIANT_BIN INVARIANT_REPO
STALE_VERSION_CARGO_PATH SUPPLY_CHAIN_ENABLED
VERSION_FILES VERSION_DRIFT_ENABLED WORKFLOW_SECURITY_ENABLED
CLIPPY_ENABLED GITLEAKS_ENABLED
_SKILLS_VENDORED
"

_bhc_key_known() {
    local k
    for k in $BHC_KNOWN_KEYS; do [ "$k" = "$1" ] && return 0; done
    return 1
}

_bhc_key_blocked() {
    local k
    # Every name the parser itself uses lives under the _bhc_ / _BHC_ prefix, so
    # reserving the prefix is the whole invariant in one line, rather than a list
    # that has to be kept in step with the code. Three separate holes were found
    # on 2026-07-26 because the list was maintained by hand and the code moved:
    # `_bhc_a` (a nameref local, circular-reference crash), `arr_name` (the loop's
    # continuation variable, read ABOVE this check, which let a config write PATH
    # and silently disable five gates), and `failed` (the error counter, so a
    # refusal still returned success).
    case "$1" in _bhc_*|_BHC_*) return 0 ;; esac
    for k in $BHC_BLOCKED_KEYS; do [ "$k" = "$1" ] && return 0; done
    return 1
}

_bhc_key_exec() {
    local k
    for k in $BHC_EXEC_KEYS; do [ "$k" = "$1" ] && return 0; done
    return 1
}

# Substitute $NAME / ${NAME} for keys this file has already assigned. Unknown
# or unset names are left verbatim, matching nothing rather than guessing.
_bhc_expand() {
    local s="$1" out='' i=0 c nm rest
    # NOTE: ${#s} must be computed after s is assigned. Bash expands an entire
    # `local a=.. b=..` line before performing any of its assignments, so
    # `local s="$1" n=${#s}` silently yields n=0.
    local n=${#s}
    while [ "$i" -lt "$n" ]; do
        c="${s:i:1}"
        if [ "$c" != '$' ]; then out+="$c"; i=$((i + 1)); continue; fi
        rest="${s:i+1}"
        if [ "${rest:0:1}" = '{' ]; then
            nm="${rest:1}"; nm="${nm%%\}*}"
            if [ "${rest#*\}}" != "$rest" ] && _bhc_key_known "$nm"; then
                out+="${!nm-}"; i=$((i + 3 + ${#nm})); continue
            fi
        else
            nm="${rest%%[!A-Za-z0-9_]*}"
            if [ -n "$nm" ] && _bhc_key_known "$nm"; then
                out+="${!nm-}"; i=$((i + 1 + ${#nm})); continue
            fi
        fi
        out+="$c"; i=$((i + 1))
    done
    printf '%s' "$out"
}

# Character scanner shared by scalars and array bodies. Walks TEXT honouring
# shell quoting, appends finished elements to _BHC_ELEMS, and sets _BHC_CLOSED
# when it consumes a `)` that sits outside quotes.
_bhc_scan() {
    local s="$1" i=0 c q='' cur='' started=0 literal=0
    local n=${#s}   # see the note in _bhc_expand: must follow s's assignment
    _bhc_flush() {
        if [ "$started" = 1 ]; then
            if [ "$literal" = 1 ]; then _BHC_ELEMS+=("$cur")
            else _BHC_ELEMS+=("$(_bhc_expand "$cur")"); fi
        fi
        cur=''; started=0; literal=0
    }
    while [ "$i" -lt "$n" ]; do
        c="${s:i:1}"; i=$((i + 1))
        if [ -n "$q" ]; then
            if [ "$c" = "$q" ]; then q=''; else cur+="$c"; fi
            continue
        fi
        case "$c" in
            "'") q="'"; started=1; [ -z "$cur" ] && literal=1 ;;
            '"') q='"'; started=1 ;;
            ')') _bhc_flush; _BHC_CLOSED=1; return 0 ;;
            '#') [ "$started" = 0 ] && return 0; cur+="$c" ;;
            ' '|$'\t') _bhc_flush ;;
            *) cur+="$c"; started=1 ;;
        esac
    done
    _bhc_flush
    return 0
}

_bhc_set_scalar()  { printf -v "$1" '%s' "$2"; }
_bhc_reset_array() { local -n _bhc_a="$1"; _bhc_a=(); }
_bhc_push_array()  { local -n _bhc_a="$1"; _bhc_a+=("$2"); }

# Parse FILE and assign the knobs it declares. Non-zero (and a message on
# stderr) when the file contains a line the grammar does not accept.
load_baseline_hook_config() {
    # Every local here is _bhc_-prefixed and therefore unassignable from the file
    # being parsed (see _bhc_key_blocked). Before 2026-07-26 these were plain
    # names, and `printf -v` in _bhc_set_scalar writes through dynamic scoping,
    # so a config line `arr_name=PATH` or `failed=0` reached straight into this
    # function's frame.
    local _bhc_file="$1"
    [ -f "$_bhc_file" ] || return 0
    local _bhc_line _bhc_lineno=0 _bhc_key _bhc_val _bhc_trimmed _bhc_arr='' _bhc_e
    local -i _bhc_failed=0

    while IFS= read -r _bhc_line || [ -n "$_bhc_line" ]; do
        _bhc_lineno=$((_bhc_lineno + 1))
        _bhc_trimmed="${_bhc_line#"${_bhc_line%%[![:space:]]*}"}"

        if [ -n "$_bhc_arr" ]; then                    # continuing NAME=( ...
            _BHC_ELEMS=(); _BHC_CLOSED=0
            _bhc_scan "$_bhc_trimmed"
            for _bhc_e in "${_BHC_ELEMS[@]}"; do _bhc_push_array "$_bhc_arr" "$_bhc_e"; done
            [ "$_BHC_CLOSED" = 1 ] && _bhc_arr=''
            continue
        fi

        case "$_bhc_trimmed" in ''|'#'*) continue ;; esac

        case "$_bhc_trimmed" in
            [A-Za-z_]*=*) _bhc_key="${_bhc_trimmed%%=*}"; _bhc_val="${_bhc_trimmed#*=}" ;;
            *) printf '%s:%d: not an assignment: %s\n' "$_bhc_file" "$_bhc_lineno" "$_bhc_trimmed" >&2
               _bhc_failed=1; continue ;;
        esac

        case "$_bhc_key" in *[!A-Za-z0-9_]*)
            printf '%s:%d: bad key name: %s\n' "$_bhc_file" "$_bhc_lineno" "$_bhc_key" >&2
            _bhc_failed=1; continue ;;
        esac

        if _bhc_key_blocked "$_bhc_key"; then
            printf '%s:%d: refusing to set %s from a project config\n' \
                   "$_bhc_file" "$_bhc_lineno" "$_bhc_key" >&2
            _bhc_failed=1; continue
        fi

        if _bhc_key_exec "$_bhc_key"; then
            printf '%s:%d: refusing to set %s from a project config: its value is\n' \
                   "$_bhc_file" "$_bhc_lineno" "$_bhc_key" >&2
            printf '  executed, so it may only come from your environment, not from a\n' >&2
            printf '  file any repository can ship. Export it in your shell instead.\n' >&2
            _bhc_failed=1; continue
        fi

        # An unrecognised name is still assigned (so a config written against a
        # newer baseline keeps working on an older hook) but is flagged, because
        # in practice the usual cause is a typo in a knob name and a silently
        # ignored gate setting is the worst outcome here.
        _bhc_key_known "$_bhc_key" || \
            printf 'warning: %s:%d: %s is not a known baseline knob (typo?)\n' \
                   "$_bhc_file" "$_bhc_lineno" "$_bhc_key" >&2

        if [ "${_bhc_val:0:1}" = '(' ]; then             # array assignment
            _bhc_reset_array "$_bhc_key"
            _BHC_ELEMS=(); _BHC_CLOSED=0
            _bhc_scan "${_bhc_val:1}"
            for _bhc_e in "${_BHC_ELEMS[@]}"; do _bhc_push_array "$_bhc_key" "$_bhc_e"; done
            [ "$_BHC_CLOSED" = 1 ] || _bhc_arr="$_bhc_key"
        else                                            # scalar assignment
            _BHC_ELEMS=(); _BHC_CLOSED=0
            _bhc_scan "$_bhc_val"
            _bhc_set_scalar "$_bhc_key" "${_BHC_ELEMS[0]-}"
        fi
    done < "$_bhc_file"

    if [ -n "$_bhc_arr" ]; then
        printf '%s: unterminated array assignment for %s\n' "$_bhc_file" "$_bhc_arr" >&2
        _bhc_failed=1
    fi
    return $_bhc_failed
}

# ── Secret value patterns (extended regex) ──────────────────────────────────
SECRET_REGEX=(
    '-----BEGIN [A-Z ]*PRIVATE KEY-----'        # any private key block
    'AKIA[0-9A-Z]{16}'                          # AWS access key id
    'ASIA[0-9A-Z]{16}'                          # AWS temporary key id
    'gh[pousr]_[A-Za-z0-9]{36,}'                # GitHub token
    'github_pat_[A-Za-z0-9_]{50,}'              # GitHub fine-grained PAT
    'glpat-[A-Za-z0-9_-]{20,}'                  # GitLab PAT
    'xox[baprs]-[A-Za-z0-9-]{10,}'              # Slack token
    'AIza[0-9A-Za-z_-]{35}'                     # Google API key
    'sk-[A-Za-z0-9]{20,}'                       # OpenAI-style secret key
    'sk_live_[0-9A-Za-z]{20,}'                  # Stripe live secret
    'sk_test_[0-9A-Za-z]{20,}'                  # Stripe test secret
    'whsec_[0-9A-Za-z]{20,}'                    # Stripe webhook secret
    'eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.'  # JWT
    '(secret|password|passwd|token|api[_-]?key)[[:space:]]*[:=][[:space:]]*["'"'"']?[A-Za-z0-9/+_-]{16,}'
)

# ── Secret-shaped filenames (basename match) ────────────────────────────────
SECRET_FILENAME_REGEX='(^|/)(id_(rsa|ecdsa|ed25519)|.*\.pem|.*\.pfx|.*\.p12|.*\.key|\.env|\.env\..*|.*\.keystore|credentials(\.json)?)$'

# ── Optional per-repo allowlist ─────────────────────────────────────────────
ALLOW_PATTERNS=()
if [[ -f .baseline-hook-allow ]]; then
    while IFS= read -r line; do
        [[ -z "$line" || "$line" == \#* ]] && continue
        ALLOW_PATTERNS+=("$line")
    done < .baseline-hook-allow
fi

is_allowlisted() {
    local content="$1"
    for pat in "${ALLOW_PATTERNS[@]:-}"; do
        [[ -z "$pat" ]] && continue
        # -e marks the next arg as a pattern, so a regex starting with '-'
        # is never mistaken for a grep option.
        if echo "$content" | grep -qE -e "$pat"; then
            return 0
        fi
    done
    return 1
}

# path_exempt PATH GLOBS — true if PATH matches any whitespace-separated glob.
# The prose gates use this to skip project-specific exempt paths (vendored
# code, generated docs, upstream material). The exempt lists are config-driven
# and empty by default, so the shipped hook stays project-agnostic; a project
# sets BRE_EXEMPT_PATHS / EMDASH_EXEMPT_PATHS / DOC_INJECTION_EXEMPT_PATHS in
# .baseline-hook-config. This keeps the hook file byte-identical across every
# project so the installer can update it without ever clobbering a local edit.
path_exempt() {
    local f="$1" globs="$2" g
    for g in $globs; do
        # shellcheck disable=SC2053
        case "$f" in $g) return 0 ;; esac
    done
    return 1
}

JOIN() { local IFS='|'; printf '%s' "$*"; }
SECRET_JOINED=$(JOIN "${SECRET_REGEX[@]}")

STAGED_DIFF=$(git diff --cached --unified=0 --no-color --diff-filter=AM 2>/dev/null || true)
STAGED_NAMES=$(git diff --cached --name-only --diff-filter=A 2>/dev/null || true)

# TD-126 single-pass: annotate every ADDED line once as file<TAB>lineno<TAB>content, replicating
# the exact line-number logic the per-gate loops used (line_no advances on every non-header line
# in a hunk). Each content gate below pre-filters this with ONE grep and loops only over its
# matching lines, so the hook is O(gates) greps over the diff, not O(lines x gates) subshells.
# grep still does the matching, so \b word boundaries and case-insensitivity keep working.
ADDED_ANNOTATED=$(awk '
    /^\+\+\+ b\// { file=substr($0,7); ln=0; next }
    /^@@ / { if (match($0,/\+[0-9]+/)) ln=substr($0,RSTART+1,RLENGTH-1)-1; next }
    /^diff --git / || /^index / || /^--- / { next }
    /^\+/ { ln++; print file "\t" ln "\t" substr($0,2); next }
    { ln++ }
' <<<"$STAGED_DIFF")

VIOLATIONS=()
FILENAME_VIOLATIONS=()

# Filename check: a key/secret file should almost never be committed.
while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    if echo "$f" | grep -qE -e "$SECRET_FILENAME_REGEX"; then
        if ! is_allowlisted "$f"; then
            FILENAME_VIOLATIONS+=("$f")
        fi
    fi
done <<<"$STAGED_NAMES"

# Content check: scan added lines only. TD-126 single-pass: one grep for a secret candidate over
# the annotated added lines; the loop runs only over the matching lines, to locate the specific
# pattern and apply the allowlist. The secret gate has no scope filter (secrets can leak anywhere).
while IFS=$'\t' read -r current_file line_no content; do
    # Re-verify on the content (the grep pre-filter can match on the file path).
    if echo "$content" | grep -qiE -e "$SECRET_JOINED"; then
        if ! is_allowlisted "$content"; then
            for pat in "${SECRET_REGEX[@]}"; do
                if echo "$content" | grep -qiE -e "$pat"; then
                    VIOLATIONS+=("${RED}${current_file}:${line_no}${RESET}  matched ${BOLD}${pat}${RESET}")
                    VIOLATIONS+=("    ${content:0:120}")
                    break
                fi
            done
        fi
    fi
done < <(grep -iE -e "$SECRET_JOINED" <<<"$ADDED_ANNOTATED")

# Deep scan with gitleaks when it is on PATH. The regex list above is the always
# on floor (works everywhere, no dependency); gitleaks adds hundreds of
# maintained rules + entropy detection for token shapes the floor misses. Absent
# gitleaks the floor still stands. Disable with GITLEAKS_ENABLED=0. Content only
# (column 3+ of the annotated diff); --redact keeps secrets off the terminal.
if [ "${GITLEAKS_ENABLED:-1}" != "0" ] && command -v gitleaks >/dev/null 2>&1; then
    gl_content=$(cut -f3- <<<"$ADDED_ANNOTATED")
    if [ -n "$gl_content" ] && ! printf '%s' "$gl_content" | gitleaks stdin --redact >/dev/null 2>&1; then
        VIOLATIONS+=("${RED}gitleaks flagged credential-shaped content in the staged additions${RESET}")
        VIOLATIONS+=("    inspect: git diff --cached | gitleaks stdin -v   (last resort: GITLEAKS_ENABLED=0)")
    fi
fi

# ── Additional baseline checks (added 2026-05-23) ───────────────────────────
#
# 1. PRIVATE-LEAK GATE: refuse any staged path inside `private/` or
#    `private-*/`. These are gitignored by convention; an explicit
#    `git add -f` is the only way to stage one, and the baseline says no.
# 2. BRITISH-ENGLISH GATE: in staged additions to *.md / source comments,
#    flag the standard list of US spellings. Allow override via
#    .baseline-hook-allow.
# 3. FUTURE-VERSION GATE (default ON): scans staged additions to
#    user-facing docs (README, AUP, CHANGELOG except the current top
#    entry, docs/**/*.md) for any future-version reference. The
#    default regex catches `v?N.M` patterns one or more major/minor
#    bumps beyond the current release. Projects can override the
#    pattern with BLOCK_FUTURE_VERSIONS_REGEX in .baseline-hook-config,
#    or disable the gate entirely with BLOCK_FUTURE_VERSIONS_ENABLED=0.
#    The opt-in era ended once Section 16 became baseline policy.

PRIVATE_VIOLATIONS=()
BRE_VIOLATIONS=()
FUTUREVER_VIOLATIONS=()
SUPPLY_CHAIN_VIOLATIONS=()
WORKFLOW_VIOLATIONS=()
EMDASH_VIOLATIONS=()
LLM_TELLS_VIOLATIONS=()

# Project-level config (optional). The project root can set:
#   BLOCK_FUTURE_VERSIONS_REGEX='\bv?[5-9]\.[0-9]+|\bv?4\.[1-9][0-9]*'
#   BLOCK_FUTURE_VERSIONS_ENABLED=0   # disable entirely (default 1)
#   BRE_ENABLED=1            # default 1
#   PRIVATE_DIRS='private private-* sandbox-*'
#   SUPPLY_CHAIN_ENABLED=1   # default 1
#   WORKFLOW_SECURITY_ENABLED=1   # default 1
BRE_ENABLED=1
PRIVATE_DIRS='private private-*'
SUPPLY_CHAIN_ENABLED=1
WORKFLOW_SECURITY_ENABLED=1
EMDASH_ENABLED=1
LLM_TELLS_ENABLED=1
# Formerly always-on, now toggleable so a converging project can reproduce its
# exact active-gate set; default 1 keeps every existing project's behaviour
# unchanged. (Secret-leak scanning stays unconditional: it is the security floor
# per baseline Section 13 and runs before config is even sourced.)
PRIVATE_LEAK_ENABLED=1
DOC_INJECTION_ENABLED=1
# Per-project prose-gate exemptions (whitespace-separated globs; empty by
# default). A project sets these in .baseline-hook-config to skip vendored,
# generated, or upstream paths without editing this file. STALE_VERSION_CARGO_PATH
# names the Cargo.toml whose version drives the stale-version-ref gate (below).
BRE_EXEMPT_PATHS=''
EMDASH_EXEMPT_PATHS=''
DOC_INJECTION_EXEMPT_PATHS=''
STALE_VERSION_CARGO_PATH=''
# IP-hygiene gate (off by default). For repos heading to a public launch: a
# project turns it on and supplies its own pattern + path lists in
# .baseline-hook-config (they are bash arrays, sourced verbatim). Two tiers:
#   Tier 1 blocks forbidden literals/regex anywhere except IP_ALLOWLIST_PATHS;
#   Tier 2 blocks them under IP_PUBLISHABLE_PATHS regardless of the allowlist,
#   with only IP_PUBLISHABLE_LEGIT_PATTERNS carved out (documented env vars,
#   canonical licence names, etc). Patterns are extended regex (grep -E).
IP_HYGIENE_ENABLED=0
IP_FORBIDDEN_REGEX=()
IP_FORBIDDEN_REGEX_CI=()
IP_ALLOWLIST_PATHS=()
IP_PUBLISHABLE_PATHS=()
IP_PUBLISHABLE_LEGIT_PATTERNS=()
# AGPL-header gate (off by default). When on, staged source files (.rs/.ts/
# .tsx/.js, excluding tests + build output) must carry the SPDX line.
AGPL_HEADER_ENABLED=0
AGPL_HEADER_SPDX='SPDX-License-Identifier: AGPL-3.0-or-later'
# Pre-commit clippy (off by default). When on, a Rust-touching commit runs a
# workspace clippy from PRECOMMIT_CLIPPY_DIR before it lands.
PRECOMMIT_CLIPPY_ENABLED=0
PRECOMMIT_CLIPPY_DIR='.'
# Future-version gate is default ON since the Section 16 baseline rule landed.
# Project sets BLOCK_FUTURE_VERSIONS_REGEX to a project-specific pattern
# (recommended — encodes the current release boundary). When the regex
# is unset the gate falls back to a conservative cross-project default
# that flags anything from v5+ outright, plus v4.2+ for projects still
# in the 4.x line. Disable with BLOCK_FUTURE_VERSIONS_ENABLED=0.
BLOCK_FUTURE_VERSIONS_ENABLED=1
# ── Enforcement-machinery compliance ────────────────────────────────────────
# When a commit changes the hooks, the hook config, or the project
# instructions, check the change against THIS repo before it lands. Fleet-wide
# fixes get written once against one project's assumptions and then land in
# twelve places where those assumptions differ. See the fragment's header for
# the two 2026-07-26 cases that motivated it.
# ── Orchestration standard ──────────────────────────────────────────────────
# Renting compute or scheduling a run across machines goes through holst. See
# the fragment's header for the 2026-07-26 incident that motivated the gate.
if [ "${SKIP_ORCHESTRATION_STANDARD:-0}" != "1" ]; then
    _os_root=$(git rev-parse --show-toplevel 2>/dev/null || true)
    if [ -n "$_os_root" ] && [ -x "$_os_root/.githooks/check-orchestration-standard.sh" ]; then
        "$_os_root/.githooks/check-orchestration-standard.sh" --staged || exit 1
    fi
fi

if [ "${SKIP_HOOK_COMPLIANCE:-0}" != "1" ]; then
    _hc_root=$(git rev-parse --show-toplevel 2>/dev/null || true)
    if [ -n "$_hc_root" ] && [ -x "$_hc_root/.githooks/check-hook-compliance.sh" ]; then
        "$_hc_root/.githooks/check-hook-compliance.sh" --staged || exit 1
    fi
fi

if [[ -f .baseline-hook-config ]]; then
    if ! load_baseline_hook_config .baseline-hook-config; then
        echo "${RED}${BOLD}REFUSED${RESET}: .baseline-hook-config has a line that is not a setting."
        echo "The baseline hooks now parse that file instead of executing it, so a"
        echo "stray command there can no longer run on your machine. Remove the lines"
        echo "named above, or express them as NAME=value / NAME=(...)."
        exit 1
    fi
fi

# Apply the conservative cross-project default when the gate is on but
# the project hasn't supplied its own pattern.
if [[ "$BLOCK_FUTURE_VERSIONS_ENABLED" = "1" ]] && [[ -z "${BLOCK_FUTURE_VERSIONS_REGEX:-}" ]]; then
    BLOCK_FUTURE_VERSIONS_REGEX='\bv?[5-9]\.[0-9]+\b|\bv?[1-9][0-9]+\.[0-9]+\b|\bv?4\.[2-9][0-9]*\b|\bv?4\.1[0-9]+\b'
fi

# 1. Private-leak gate.
if [[ "$PRIVATE_LEAK_ENABLED" = "1" ]]; then
STAGED_FOR_PRIVATE=$(git diff --cached --name-only --diff-filter=AM 2>/dev/null || true)
while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    for dir in $PRIVATE_DIRS; do
        # shellcheck disable=SC2053
        # Allow glob expansion against the literal path.
        if [[ "$f" == $dir/* ]] || [[ "$f" == */$dir/* ]] || [[ "$f" == "$dir" ]]; then
            if ! is_allowlisted "$f"; then
                PRIVATE_VIOLATIONS+=("$f")
            fi
            break
        fi
    done
done <<<"$STAGED_FOR_PRIVATE"
fi

# 2. British-English gate.
# Word list — the high-confidence half of the US/UK spelling spread.
# Identifiers in code (`color: red`, `ColorType`, `behavior_t`) escape via
# .baseline-hook-allow on a case-by-case basis. The check below only
# inspects *.md and lines that look like source comments.
# Word list — only the high-confidence US-only spellings. Words with
# noun-verb ambiguity in British English are deliberately excluded:
#   - "license" (BrE: noun "licence", verb "license") — too contextual
#   - "practice" (BrE: noun "practice", verb "practise")
# These would false-positive on legitimate BrE prose; the cost of
# missing them is small.
BRE_PATTERNS='\b(analyze|analyzed|analyzes|analyzing|color|colors|colored|coloring|behavior|behaviors|behavioral|recognize|recognized|recognizes|recognizing|organize|organized|organizing|organization|organizations|optimize|optimized|optimizes|optimizing|optimization|optimizations|defense|defenses|honor|honored|honoring|favor|favored|favoring|labor|labors|labored|center|centered|centering|centers|meter|meters|liter|liters|fiber|fibers|specialize|specialized|specializing|customize|customized|customizing|customization|catalog|catalogs|cataloged|cataloging)\b'

if [[ "$BRE_ENABLED" = "1" ]]; then
    # TD-126 single-pass: one grep for a US spelling over the annotated added lines; loop only over hits.
    while IFS=$'\t' read -r current_file line_no content; do
        # Per-project exemptions (config-driven; empty by default).
        if [[ -n "$BRE_EXEMPT_PATHS" ]] && path_exempt "$current_file" "$BRE_EXEMPT_PATHS"; then continue; fi
        # Only inspect prose surfaces.
        case "$current_file" in
            *.md|*.txt|*.markdown|*.adoc|README*|CHANGELOG*|CONTRIBUTING*|SECURITY*|AUP*|COMMERCIAL*) ;;
            *.rs|*.ts|*.tsx|*.js|*.py|*.sh|*.toml|*.yml|*.yaml)
                # Source files: only check lines that look like comments.
                if ! [[ "$content" =~ ^[[:space:]]*(//|#|/\*|\*) ]]; then
                    continue
                fi
                ;;
            *) continue ;;
        esac
        # Re-verify on the content (the grep pre-filter can match on the file path).
        if echo "$content" | grep -qiE -e "$BRE_PATTERNS"; then
            if ! is_allowlisted "$content"; then
                match=$(echo "$content" | grep -oiE -e "$BRE_PATTERNS" | head -1)
                BRE_VIOLATIONS+=("${RED}${current_file}:${line_no}${RESET}  ${BOLD}${match}${RESET}")
                BRE_VIOLATIONS+=("    ${content:0:120}")
            fi
        fi
    done < <(grep -iE -e "$BRE_PATTERNS" <<<"$ADDED_ANNOTATED")
fi

# 3. Future-version gate (opt-in).
#
# Scope precedence:
#   1. If BLOCK_FUTURE_VERSIONS_PATHS is set in .baseline-hook-config,
#      ONLY files matching one of those glob patterns are checked.
#      Use this to scope the gate to publishable artefacts only
#      (README.md, AGENTS.md, CHANGELOG.md, per-crate READMEs), keeping
#      internal planning docs (the complete plan, docs/architecture.md,
#      etc.) exempt per CLAUDE.md §16.
#   2. Otherwise the baseline default scope applies: README*, AUP.md,
#      COMMERCIAL.md, docs/*.md, frontend/README.md.
if [[ "$BLOCK_FUTURE_VERSIONS_ENABLED" = "1" ]] && [[ -n "${BLOCK_FUTURE_VERSIONS_REGEX:-}" ]]; then
    # TD-126 single-pass: one grep for a future-version candidate over the annotated added lines;
    # the loop (scope + allowlist) runs only over the matching lines.
    while IFS=$'\t' read -r current_file line_no content; do
        # Scope precedence: BLOCK_FUTURE_VERSIONS_PATHS (whitespace-separated
        # globs) wins; else the legacy FUTUREVER_PATHS alias (a single
        # case-alternation pattern, e.g. `README*|AUP.md|docs/marketing/*.md`,
        # kept so the crazy/azunche lineage converges without behaviour change);
        # else the baseline default scope.
        if [[ -n "${BLOCK_FUTURE_VERSIONS_PATHS:-}" ]]; then
            in_scope=0
            for pat in $BLOCK_FUTURE_VERSIONS_PATHS; do
                # shellcheck disable=SC2053
                case "$current_file" in
                    $pat) in_scope=1; break ;;
                esac
            done
            if [[ "$in_scope" -eq 0 ]]; then
                continue
            fi
        elif [[ -n "${FUTUREVER_PATHS:-}" ]]; then
            # Legacy alias: a |-separated case-alternation. It must be split on
            # "|" and each alternative matched as its own glob; a bare
            # `case "$f" in $FUTUREVER_PATHS)` does NOT treat a "|" that arrives
            # via variable expansion as alternation (it is literal), which is why
            # the crazy/azunche lineage scope never actually matched.
            in_scope=0
            IFS='|' read -ra _fv_pats <<<"$FUTUREVER_PATHS"
            for pat in "${_fv_pats[@]}"; do
                # shellcheck disable=SC2053
                case "$current_file" in
                    $pat) in_scope=1; break ;;
                esac
            done
            if [[ "$in_scope" -eq 0 ]]; then
                continue
            fi
        else
            case "$current_file" in
                README*|AUP.md|COMMERCIAL.md|docs/*.md|frontend/README.md) ;;
                *) continue ;;
            esac
        fi
        # Re-verify on the content (the grep pre-filter can match on the file path/line number).
        if echo "$content" | grep -qE -e "$BLOCK_FUTURE_VERSIONS_REGEX"; then
            if ! is_allowlisted "$content"; then
                match=$(echo "$content" | grep -oE -e "$BLOCK_FUTURE_VERSIONS_REGEX" | head -1)
                FUTUREVER_VIOLATIONS+=("${RED}${current_file}:${line_no}${RESET}  ${BOLD}${match}${RESET}")
                FUTUREVER_VIOLATIONS+=("    ${content:0:120}")
            fi
        fi
    done < <(grep -E -e "$BLOCK_FUTURE_VERSIONS_REGEX" <<<"$ADDED_ANNOTATED")
fi

# 4. Stale-version-ref gate (warn-only, off by default).
#
# Warns when a manually-written vMAJ.MIN.PAT reference in operator-facing docs
# is more than one patch behind the source-of-truth crate's current version.
# Project-agnostic: a project turns it on in .baseline-hook-config with
#   BLOCK_STALE_VERSION_REF_ENABLED=1
#   BLOCK_STALE_VERSION_REF_PATHS='OPERATOR_ACTIONS.md crates/*/README.md AGENTS.md'
#   STALE_VERSION_CARGO_PATH='crates/<published-crate>/Cargo.toml'
# Warn-only: historical refs ("v0.0.1 was the first release") are legitimate,
# so the operator reads the warnings and decides per line.
STALEVER_WARNINGS=()
if [[ "${BLOCK_STALE_VERSION_REF_ENABLED:-0}" = "1" ]] && [[ -n "${BLOCK_STALE_VERSION_REF_PATHS:-}" ]] && [[ -n "${STALE_VERSION_CARGO_PATH:-}" ]]; then
    cli_cargo="$STALE_VERSION_CARGO_PATH"
    if [[ -f "$cli_cargo" ]]; then
        CURRENT_V=$(awk -F\" '/^version = / {print $2; exit}' "$cli_cargo")
        # Parse current = major.minor.patch
        if [[ "$CURRENT_V" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+) ]]; then
            CUR_MAJ="${BASH_REMATCH[1]}"
            CUR_MIN="${BASH_REMATCH[2]}"
            CUR_PAT="${BASH_REMATCH[3]}"
            # Compute the floor (current - 1 patch; clamped at 0).
            FLOOR_PAT=$(( CUR_PAT > 0 ? CUR_PAT - 1 : 0 ))

            # Glob-expand the configured paths.
            scoped_files=""
            for pat in $BLOCK_STALE_VERSION_REF_PATHS; do
                # shellcheck disable=SC2086
                for f in $pat; do
                    [[ -e "$f" ]] && scoped_files+=" $f"
                done
            done

            # TD-126 single-pass: one grep for a version token over the annotated added lines;
            # the loop (scope + per-token comparison) runs only over the matching lines.
            while IFS=$'\t' read -r current_file line_no content; do
                # Only scan staged files inside the configured paths.
                case " $scoped_files " in
                    *" $current_file "*) ;;
                    *) continue ;;
                esac
                # Extract every vMAJ.MIN.PAT pattern on the added line.
                while read -r match; do
                    [[ -z "$match" ]] && continue
                    if [[ "$match" =~ ^v?([0-9]+)\.([0-9]+)\.([0-9]+) ]]; then
                        M="${BASH_REMATCH[1]}"
                        N="${BASH_REMATCH[2]}"
                        P="${BASH_REMATCH[3]}"
                        # Stale if same major+minor but patch < floor.
                        if [[ "$M" == "$CUR_MAJ" && "$N" == "$CUR_MIN" && "$P" -lt "$FLOOR_PAT" ]]; then
                            if ! is_allowlisted "$content"; then
                                STALEVER_WARNINGS+=("${YELLOW}${current_file}:${line_no}${RESET}  stale ref ${BOLD}${match}${RESET} (current is ${CUR_MAJ}.${CUR_MIN}.${CUR_PAT})")
                                STALEVER_WARNINGS+=("    ${content:0:120}")
                            fi
                        fi
                    fi
                done < <(echo "$content" | grep -oE 'v?[0-9]+\.[0-9]+\.[0-9]+' || true)
            done < <(grep -E 'v?[0-9]+\.[0-9]+\.[0-9]+' <<<"$ADDED_ANNOTATED")
        fi
    fi
fi

# Em-dash gate. Flags em dash (U+2014) and prose en dash (U+2013)
# only when they appear as a *dramatic-pause LLM tic* in flowing
# prose. Em-dashes have legitimate uses (label-description bullets,
# table cells, section-header separators, tree-map alignment), and
# the Section 19 wording explicitly permits those. The hook therefore
# inspects each staged line and skips:
#
#   - bullet/list items (`- term — description`)
#   - markdown table cells (lines starting with `|`)
#   - section headers (lines starting with `#`)
#   - blockquote lines (`> ...`)
#   - lines that look like tree-map / file-map alignment (two or
#     more spaces immediately before the em dash)
#   - lines containing inline code (`` ` ``)
#
# Anything left is prose. If the prose line contains an em or en
# dash, that is the LLM tic pattern; flag it.
#
# Override per-line via .baseline-hook-allow; disable entirely via
# EMDASH_ENABLED=0 in .baseline-hook-config.
if [[ "$EMDASH_ENABLED" = "1" ]]; then
    # TD-126 single-pass: one grep for a dash over the annotated added lines; the loop (scope +
    # exclusions + allowlist) runs only over the matching lines, not the whole diff.
    while IFS=$'\t' read -r current_file line_no content; do
        # Guard: the dash must be in the CONTENT, not just the filename (builtin, no subshell).
        [[ "$content" == *—* || "$content" == *–* ]] || continue
        # Per-project exemptions (config-driven; empty by default).
        if [[ -n "$EMDASH_EXEMPT_PATHS" ]] && path_exempt "$current_file" "$EMDASH_EXEMPT_PATHS"; then continue; fi
        # Scope: prose surfaces + source comments (same as BrE check).
        case "$current_file" in
            *.md|*.markdown|*.adoc|*.txt|README*|CHANGELOG*|CONTRIBUTING*|SECURITY*|AUP*|COMMERCIAL*) ;;
            *.rs|*.ts|*.tsx|*.js|*.py|*.sh|*.toml|*.yml|*.yaml)
                if ! [[ "$content" =~ ^[[:space:]]*(//|#|/\*|\*) ]]; then
                    continue
                fi
                ;;
            *) continue ;;
        esac
        # Legitimate-use exclusions. Strip leading whitespace once.
        trimmed="${content#"${content%%[![:space:]]*}"}"
        case "$trimmed" in
            '#'*|'>'*|'|'*|'```'*) continue ;;
            '- '*|'* '*|'+ '*|[0-9]*'. '*) continue ;;
            # Box-drawing tree-map / file-map lines.
            '├──'*|'└──'*|'│'*) continue ;;
        esac
        # Two or more consecutive spaces suggest column alignment (layout, not prose).
        if echo "$content" | grep -qE '[[:space:]]{2,}'; then
            continue
        fi
        # Inline code on the line (likely a `value` — note pair).
        if echo "$content" | grep -qE '`[^`]+`.*—|—.*`[^`]+`'; then
            continue
        fi
        if ! is_allowlisted "$content"; then
            EMDASH_VIOLATIONS+=("${RED}${current_file}:${line_no}${RESET}")
            EMDASH_VIOLATIONS+=("    ${content:0:140}")
        fi
    done < <(grep -E -e '—|–' <<<"$ADDED_ANNOTATED")
fi

# LLM-tells gate. Flags the highest-confidence "this was written by
# an LLM" signals in additions to public docs (baseline Section 21).
# Highlights, not nukes — the offender is still allowed via
# .baseline-hook-allow when the word is genuinely right.
if [[ "$LLM_TELLS_ENABLED" = "1" ]]; then
    # Patterns ordered from highest-confidence to weakest.
    LLM_TELL_PATTERNS=(
        # Negative parallelism — strong AI signature.
        "(it'?s|this[[:space:]]+is|that'?s)[[:space:]]+not[[:space:]]+(just|only|merely|simply|about)[[:space:]]+[A-Za-z]"
        "not[[:space:]]+just[[:space:]]+[A-Za-z]+[[:space:]]+(but|it'?s|they'?re|we'?re)"
        # Hedge / weight phrases.
        "it'?s[[:space:]]+(important|worth|critical|essential)[[:space:]]+to[[:space:]]+note"
        "it[[:space:]]+should[[:space:]]+be[[:space:]]+noted"
        "needless[[:space:]]+to[[:space:]]+say"
        # Sycophantic openers (mostly chat, but they leak into docs).
        "^[[:space:]]*(Great[[:space:]]+question|Absolutely|Certainly)!"
        # The LLM vocabulary watchlist.
        '\b(delve|delves|delving|leverage|leverages|leveraged|leveraging|tapestry|realm|holistic|paradigm|multifaceted|seamless|seamlessly|robust|robustness|unleash|unleashes|unleashing|elevate|elevates|elevating|foster|fosters|fostering|comprehensive|comprehensively|intricately|profoundly|navigate(s|d|)[[:space:]]+(the[[:space:]]+complexities|the[[:space:]]+landscape|the[[:space:]]+realm))\b'
        # Curly / smart quotes (signal AI rendering or autocorrect).
        $'“|”|‘|’'
        # Paragraph-start transition crutches.
        "^(Moreover|Furthermore|Additionally|In[[:space:]]+conclusion|In[[:space:]]+summary)[[:space:]]*,"
    )
    # TD-126 single-pass pre-filter: the union of the tell patterns with any leading ^ anchor
    # stripped, so the anchored openers (sycophantic / paragraph-start) still register as
    # candidates against the annotated line. The per-pattern loop below re-applies the true
    # (still-anchored) patterns to the content, so anchoring stays correct.
    LLM_TELL_PREFILTER_PARTS=()
    for p in "${LLM_TELL_PATTERNS[@]}"; do
        LLM_TELL_PREFILTER_PARTS+=("${p#^}")
    done
    LLM_TELL_PREFILTER=$(JOIN "${LLM_TELL_PREFILTER_PARTS[@]}")
    while IFS=$'\t' read -r current_file line_no content; do
        # Scope: ONLY public-facing docs (per Section 20 register split).
        # Internal docs (ARCHITECTURE, CHANGELOG, private/, runbooks)
        # are tolerated; these patterns get caught only on the
        # consumer-facing surface.
        case "$current_file" in
            README*|AUP.md|COMMERCIAL.md|docs/user-guide.md|docs/vs-alternatives.md|docs/security-model.md|frontend/README.md) ;;
            *) continue ;;
        esac
        for p in "${LLM_TELL_PATTERNS[@]}"; do
            if echo "$content" | grep -qiE -e "$p"; then
                if ! is_allowlisted "$content"; then
                    match=$(echo "$content" | grep -oiE -e "$p" | head -1)
                    LLM_TELLS_VIOLATIONS+=("${RED}${current_file}:${line_no}${RESET}  ${BOLD}${match}${RESET}")
                    LLM_TELLS_VIOLATIONS+=("    ${content:0:140}")
                fi
                break
            fi
        done
    done < <(grep -iE -e "$LLM_TELL_PREFILTER" <<<"$ADDED_ANNOTATED")
fi

# 4. Supply-chain gate (package.json scripts, Cargo.lock registries).
#
# Patterns modelled after real 2024-2026 incidents:
#   - Shai-Hulud (Sep 2025): postinstall script reads $GITHUB_TOKEN
#   - Shai-Hulud 2.0 (Nov 2025): pre-install with curl-to-attacker
#   - chrono_anchor / time_calibrator (Feb-March 2026): .env exfil
#   - faster_log / async_println (Sep 2025): non-crates.io registry
if [[ "$SUPPLY_CHAIN_ENABLED" = "1" ]]; then
    while IFS= read -r f; do
        [[ -z "$f" ]] && continue
        # Skip target/, node_modules/, vendored deps.
        case "$f" in
            */target/*|*/node_modules/*|*/vendor/*|*/.git/*) continue ;;
        esac

        case "$(basename "$f")" in
            package.json)
                # Read the file (the staged blob, not the working tree).
                # We need the staged version because the developer might
                # have edited but not staged a fix.
                content=$(git show ":$f" 2>/dev/null || cat "$f" 2>/dev/null || echo "")
                # Look at scripts blocks. Block:
                #   - postinstall / preinstall / postpublish / postinstall-* with curl/wget/network commands
                #   - any install hook that references $GITHUB_TOKEN / $NPM_TOKEN / $AWS_*
                if echo "$content" | grep -qE '"(pre|post)?(install|publish|prepare)"[[:space:]]*:[[:space:]]*"[^"]*\b(curl|wget|nc|netcat|node[[:space:]]+-e|python3?[[:space:]]+-c|/dev/tcp/)' \
                   || echo "$content" | grep -qE '"(pre|post)?(install|publish|prepare)"[[:space:]]*:[[:space:]]*"[^"]*\$(GITHUB_TOKEN|NPM_TOKEN|AWS_(ACCESS|SECRET)|ANTHROPIC|OPENAI)' ; then
                    SUPPLY_CHAIN_VIOLATIONS+=("${RED}$f${RESET}: install-script references network tool or sensitive env var — Shai-Hulud / GhostAction signature")
                fi
                ;;
            Cargo.lock)
                content=$(git show ":$f" 2>/dev/null || cat "$f" 2>/dev/null || echo "")
                # Any source line that points at a non-crates.io registry
                # is suspicious. Walk the source lines explicitly to avoid
                # depending on grep -P negative lookahead (not portable).
                while IFS= read -r src_line; do
                    [[ -z "$src_line" ]] && continue
                    # Allow the canonical crates.io-index, the sparse index,
                    # and `git+...` deps (these are intentional and the
                    # developer must already have written them).
                    if echo "$src_line" | grep -qE 'registry\+https?://github\.com/rust-lang/crates\.io-index|registry\+sparse\+https?://index\.crates\.io|^source[[:space:]]*=[[:space:]]*"git\+' ; then
                        continue
                    fi
                    SUPPLY_CHAIN_VIOLATIONS+=("${RED}$f${RESET}: Cargo.lock declares a non-crates.io registry — ${src_line} — typosquat / private-registry-poisoning signature")
                    break
                done < <(echo "$content" | grep -E '^source[[:space:]]*=' || true)
                # Specific crates flagged in 2025-2026 cargo advisories.
                if echo "$content" | grep -qE 'name[[:space:]]*=[[:space:]]*"(faster_log|async_println|chrono_anchor|time_calibrator[s]?|time-sync|dnp3times)"' ; then
                    SUPPLY_CHAIN_VIOLATIONS+=("${RED}$f${RESET}: Cargo.lock contains a crate flagged in 2025-2026 crates.io advisories — remove immediately")
                fi
                ;;
            build.rs)
                # build.rs that calls the network at build time is a
                # canonical exfil pattern (CrateDepression family). Look
                # for explicit reqwest/ureq/curl_easy/http_req/std::net
                # usage in the staged build script.
                content=$(git show ":$f" 2>/dev/null || cat "$f" 2>/dev/null || echo "")
                if echo "$content" | grep -qE '\b(reqwest|ureq|isahc|attohttpc|curl_easy|http_req)::|std::net::Tcp(Stream|Listener)|std::process::Command::new\("(curl|wget|nc|nslookup)"' ; then
                    SUPPLY_CHAIN_VIOLATIONS+=("${RED}$f${RESET}: build.rs calls the network at build time — CrateDepression / time_calibrator signature. Build scripts must not reach the network.")
                fi
                ;;
        esac

        # Runtime exfil heuristic (closes the cargo runtime key-scanner
        # gap modelled after async_println / faster_log Sep 2025). Fires
        # when a single staged Rust source file combines THREE signals
        # that legitimate code rarely has together:
        #   (a) filesystem traversal — walkdir / read_dir / glob /
        #       jwalk / ignore::Walk
        #   (b) reading file content — read_to_string / fs::read /
        #       File::open + read
        #   (c) outbound network — reqwest / ureq / isahc / attohttpc /
        #       hyper::Client / tokio::net::TcpStream::connect /
        #       std::process::Command exec'ing curl/wget/nc
        # Plus one of: sensitive-string hints (private[_-]?key, mnemonic,
        # seed[[:space:]]?phrase, wallet, BEGIN [A-Z ]*PRIVATE KEY,
        # AKIA[0-9A-Z]{16}, ghp_[A-Za-z0-9]{36}, sk-[A-Za-z0-9]{20,},
        # xox[a-z]-[0-9-]+, "Solana", ".env", credential).
        # All three signals together with a sensitive-string trigger
        # the violation. Override via .baseline-hook-allow for the
        # narrow legitimate case (a crawler + uploader is a real thing,
        # but it should explicitly say so).
        case "$f" in
            *.rs)
                # Skip vendored / out-of-tree code we don't author.
                case "$f" in
                    */target/*|*/vendor/*|*/third_party/*|*/.cargo/*) ;;
                    *)
                        content=$(git show ":$f" 2>/dev/null || cat "$f" 2>/dev/null || echo "")
                        sig_walk=$(echo "$content" | grep -cE '\b(walkdir::WalkDir|jwalk::WalkDir|ignore::Walk|glob::glob|std::fs::read_dir)\b' || true)
                        sig_read=$(echo "$content" | grep -cE '\b(read_to_string|std::fs::read\b|fs::read\b|fs::File::open|BufReader::new)' || true)
                        sig_net=$(echo "$content" | grep -cE '\b(reqwest::|ureq::|isahc::|attohttpc::|hyper::Client|tokio::net::TcpStream::connect)\b|std::process::Command::new\("(curl|wget|nc|nslookup|powershell|cmd)"' || true)
                        sig_sensitive=$(echo "$content" | grep -ciE 'private[_-]?key|mnemonic|seed[[:space:]_-]*phrase|wallet|BEGIN [A-Z ]*PRIVATE KEY|AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{36}|\bsk-[A-Za-z0-9]{20,}|xox[a-z]-[0-9-]+|solana|\\.env' || true)
                        if [ "$sig_walk" -gt 0 ] && [ "$sig_read" -gt 0 ] && [ "$sig_net" -gt 0 ] && [ "$sig_sensitive" -gt 0 ]; then
                            if ! is_allowlisted "$f"; then
                                SUPPLY_CHAIN_VIOLATIONS+=("${RED}$f${RESET}: combines filesystem traversal + file-content read + outbound network + sensitive-credential string. This is the runtime exfil signature seen in faster_log / async_println (Sep 2025). If this is intentional (a credential-finding tool), add an entry to .baseline-hook-allow naming the file and why.")
                            fi
                        fi
                        ;;
                esac
                ;;
        esac
    done < <(git diff --cached --name-only --diff-filter=AM 2>/dev/null || true)
fi

# 5. Workflow security gate (.github/workflows/*.yml).
#
# Patterns modelled after:
#   - Grafana (April 2025): pull_request_target checking out untrusted ref
#   - Fake CI Updates (March 2026): same pattern at scale
#   - tj-actions/changed-files (March 2025): unpinned 3rd-party action
#   - GhostAction (Sep 2025): same shape with malicious commit-injection
if [[ "$WORKFLOW_SECURITY_ENABLED" = "1" ]]; then
    while IFS= read -r f; do
        [[ -z "$f" ]] && continue
        case "$f" in
            .github/workflows/*.yml|.github/workflows/*.yaml) ;;
            *) continue ;;
        esac
        content=$(git show ":$f" 2>/dev/null || cat "$f" 2>/dev/null || echo "")

        # 5a. pull_request_target + checkout of head ref.
        if echo "$content" | grep -qE 'pull_request_target' \
           && echo "$content" | grep -qE 'ref:[[:space:]]*\$\{\{[[:space:]]*github\.event\.pull_request\.head' ; then
            WORKFLOW_VIOLATIONS+=("${RED}$f${RESET}: pull_request_target trigger checks out github.event.pull_request.head.* (Grafana/Trivy pattern). Use 'pull_request' or pin to base ref.")
        fi

        # 5b. Direct shell interpolation of github.event.* in run blocks.
        # The run block is bash; ${{ github.event.X.Y }} interpolation
        # happens *before* shell quoting, so untrusted content (PR title,
        # branch name, issue body) becomes script. The fix is to pass
        # via env: and reference via shell var.
        #
        # Detection: any line in a YAML run-block-context that
        # interpolates github.event.*. A run-block-context is either:
        #   (a) the same line as `run:` (single-line form)
        #   (b) any indented line between `run: |` and the next step.
        run_block_lines=$(echo "$content" | awk '
            # Single-line run.
            /^[[:space:]]*(-[[:space:]]+)?run:[[:space:]]*[^|>[:space:]]/ { print; next }
            # Multi-line run start.
            /^[[:space:]]*(-[[:space:]]+)?run:[[:space:]]*[|>]/ { in_run = 1; next }
            # End of multi-line block: next step header.
            in_run && /^[[:space:]]*(-[[:space:]]+)?(name|uses|with|env|id|if):/ { in_run = 0; next }
            in_run && /^[[:space:]]*-[[:space:]]/ { in_run = 0; next }
            in_run { print }
        ')
        if echo "$run_block_lines" | grep -qE '\$\{\{[[:space:]]*github\.event\.[a-zA-Z_][a-zA-Z0-9_.]*' ; then
            WORKFLOW_VIOLATIONS+=("${RED}$f${RESET}: run-block directly interpolates \${{ github.event.* }}. Untrusted user-controlled text (PR titles, branch names, issue bodies) becomes shell. Pass via env: and reference as a shell variable.")
        fi

        # 5c. Unpinned 3rd-party actions (anything not actions/* or
        # github/*) that use @branch instead of @<full-sha>. Pin tools
        # by SHA, not tag, per the supply-chain baseline.
        #
        # Respect .baseline-hook-allow — projects that trust a vendor
        # can allowlist them with a comment explaining why.
        while IFS= read -r uses_line; do
            [[ -z "$uses_line" ]] && continue
            # Skip official actions/* and github/* and project-local ./.github.
            if echo "$uses_line" | grep -qE 'uses:[[:space:]]*(actions/|github/|\./)'; then
                continue
            fi
            # Match @<not-40hex>.
            if echo "$uses_line" | grep -qE 'uses:[[:space:]]*[^@]+@(main|master|develop|v[0-9]+(\.[0-9]+)*|latest)' ; then
                # Allowlist check: if the trimmed `uses:` line matches an
                # allow pattern, skip.
                trimmed=$(echo "$uses_line" | sed -E 's/^[[:space:]]*-[[:space:]]*//; s/^[[:space:]]*//')
                if is_allowlisted "$trimmed"; then
                    continue
                fi
                WORKFLOW_VIOLATIONS+=("${RED}$f${RESET}: 3rd-party action pinned by tag/branch, not SHA: ${trimmed}. tj-actions/changed-files compromise (March 2025) is the canonical incident. Pin by 40-char commit SHA, or add a precise allowlist entry to .baseline-hook-allow with a comment explaining why.")
            fi
        done < <(echo "$content" | grep -E '^\s*-\s*uses:' || true)
    done < <(git diff --cached --name-only --diff-filter=AM 2>/dev/null || true)
fi

# 7. IP-hygiene gate (Tier 1 + Tier 2). Off by default; a public-launch repo
# turns it on and supplies its pattern + path arrays in .baseline-hook-config.
# Absorbed from the dokima / anya bespoke hooks so the capability is shared, but
# with empty defaults it is inert for every repo that does not opt in.
IP_VIOLATIONS=()
IP_PUBLISHABLE_VIOLATIONS=()
if [[ "$IP_HYGIENE_ENABLED" = "1" ]] && { [[ ${#IP_FORBIDDEN_REGEX[@]} -gt 0 ]] || [[ ${#IP_FORBIDDEN_REGEX_CI[@]} -gt 0 ]]; }; then
    ip_path_allowlisted() {
        local f="$1" p
        for p in "${IP_ALLOWLIST_PATHS[@]:-}"; do
            [[ -z "$p" ]] && continue
            [[ "$f" == "$p"* ]] && return 0
        done
        return 1
    }
    ip_is_publishable() {
        local f="$1" p
        for p in "${IP_PUBLISHABLE_PATHS[@]:-}"; do
            [[ -z "$p" ]] && continue
            [[ "$f" == "$p"* || "$f" == *"/$p"* ]] && return 0
        done
        return 1
    }
    ip_strip_legit() {
        local s="$1" legit
        for legit in "${IP_PUBLISHABLE_LEGIT_PATTERNS[@]:-}"; do
            [[ -z "$legit" ]] && continue
            s=$(echo "$s" | sed -E "s/${legit}//g" 2>/dev/null || echo "$s")
        done
        echo "$s"
    }
    IP_JOINED=""
    [[ ${#IP_FORBIDDEN_REGEX[@]} -gt 0 ]] && IP_JOINED=$(JOIN "${IP_FORBIDDEN_REGEX[@]}")
    IP_JOINED_CI=""
    [[ ${#IP_FORBIDDEN_REGEX_CI[@]} -gt 0 ]] && IP_JOINED_CI=$(JOIN "${IP_FORBIDDEN_REGEX_CI[@]}")
    # Walk the annotated added lines. Per line: Tier 2 (publishable strict, no
    # allowlist) then Tier 1 (allowlist applies). The joined-regex fast check
    # gates the per-pattern loop, so a clean line costs one or two greps.
    while IFS=$'\t' read -r current_file line_no content; do
        if ip_is_publishable "$current_file"; then
            stripped=$(ip_strip_legit "$content")
            if [[ -n "$IP_JOINED" ]] && echo "$stripped" | grep -qE -e "$IP_JOINED"; then
                for pat in "${IP_FORBIDDEN_REGEX[@]}"; do
                    if echo "$stripped" | grep -qE -e "$pat"; then
                        IP_PUBLISHABLE_VIOLATIONS+=("${RED}${current_file}:${line_no}${RESET}  ${BOLD}${pat}${RESET}")
                        IP_PUBLISHABLE_VIOLATIONS+=("    ${content:0:140}")
                    fi
                done
            fi
            if [[ -n "$IP_JOINED_CI" ]] && echo "$stripped" | grep -qiE -e "$IP_JOINED_CI"; then
                for pat in "${IP_FORBIDDEN_REGEX_CI[@]}"; do
                    if echo "$stripped" | grep -qiE -e "$pat"; then
                        IP_PUBLISHABLE_VIOLATIONS+=("${RED}${current_file}:${line_no}${RESET}  ${BOLD}${pat}${RESET} (case-insensitive)")
                        IP_PUBLISHABLE_VIOLATIONS+=("    ${content:0:140}")
                    fi
                done
            fi
        fi
        if ip_path_allowlisted "$current_file"; then
            continue
        fi
        if [[ -n "$IP_JOINED" ]] && echo "$content" | grep -qE -e "$IP_JOINED"; then
            for pat in "${IP_FORBIDDEN_REGEX[@]}"; do
                if echo "$content" | grep -qE -e "$pat"; then
                    IP_VIOLATIONS+=("${RED}${current_file}:${line_no}${RESET}  ${BOLD}${pat}${RESET}")
                    IP_VIOLATIONS+=("    ${content:0:140}")
                fi
            done
        fi
        if [[ -n "$IP_JOINED_CI" ]] && echo "$content" | grep -qiE -e "$IP_JOINED_CI"; then
            for pat in "${IP_FORBIDDEN_REGEX_CI[@]}"; do
                if echo "$content" | grep -qiE -e "$pat"; then
                    IP_VIOLATIONS+=("${RED}${current_file}:${line_no}${RESET}  ${BOLD}${pat}${RESET} (case-insensitive)")
                    IP_VIOLATIONS+=("    ${content:0:140}")
                fi
            done
        fi
    done <<<"$ADDED_ANNOTATED"
fi

# 8. AGPL-header gate. Off by default; AGPL projects turn it on. Staged source
# files (.rs/.ts/.tsx/.js, excluding tests + build output) must carry the SPDX
# line in their first 12 lines. Absorbed from the dokima hook.
AGPL_VIOLATIONS=()
if [[ "$AGPL_HEADER_ENABLED" = "1" ]]; then
    while IFS= read -r f; do
        [[ -z "$f" ]] && continue
        case "$f" in
            target/*|*/target/*|node_modules/*|*/node_modules/*|.next/*|*/.next/*|dist/*|*/dist/*|build/*|*/build/*) continue ;;
        esac
        case "$f" in
            *.rs|*.ts|*.tsx|*.js) ;;
            *) continue ;;
        esac
        [[ "$f" == */tests/* || "$f" == tests/* ]] && continue
        if [[ -f "$f" ]] && ! head -12 "$f" | grep -q "$AGPL_HEADER_SPDX"; then
            AGPL_VIOLATIONS+=("$f")
        fi
    done < <(git diff --cached --name-only --diff-filter=AM 2>/dev/null || true)
fi

FAIL=0

if [[ ${#FILENAME_VIOLATIONS[@]} -gt 0 ]]; then
    echo
    echo "${RED}${BOLD}SECRET-FILE GATE: commit blocked${RESET}"
    echo
    echo "These staged files look like key or secret files and should"
    echo "almost never be committed. Add them to .gitignore instead."
    echo
    for f in "${FILENAME_VIOLATIONS[@]}"; do echo "  $f"; done
    FAIL=1
fi

if [[ ${#VIOLATIONS[@]} -gt 0 ]]; then
    echo
    echo "${RED}${BOLD}SECRET-CONTENT GATE: commit blocked${RESET}"
    echo
    echo "Staged lines contain something shaped like a credential:"
    echo
    for v in "${VIOLATIONS[@]}"; do echo "  $v"; done
    echo
    echo "${YELLOW}If this is a genuine false positive:${RESET} add a precise"
    echo "regex to .baseline-hook-allow with a comment explaining why."
    FAIL=1
fi

if [[ ${#PRIVATE_VIOLATIONS[@]} -gt 0 ]]; then
    echo
    echo "${RED}${BOLD}PRIVATE-LEAK GATE: commit blocked${RESET}"
    echo
    echo "These staged paths live under a private/ directory and should"
    echo "never be committed. private/ is conventionally gitignored;"
    echo "you must have used \`git add -f\` to get them here."
    echo
    for f in "${PRIVATE_VIOLATIONS[@]}"; do echo "  $f"; done
    echo
    echo "${YELLOW}If this file genuinely belongs in the public tree,${RESET}"
    echo "move it out of private/ first."
    FAIL=1
fi

if [[ ${#BRE_VIOLATIONS[@]} -gt 0 ]]; then
    echo
    echo "${RED}${BOLD}BRITISH-ENGLISH GATE: commit blocked${RESET}"
    echo
    echo "Staged prose lines use US spelling. The baseline rule"
    echo "(CLAUDE.md Section 14) is British English in chat, docs, comments,"
    echo "commit messages, and user-facing strings."
    echo
    for v in "${BRE_VIOLATIONS[@]}"; do echo "  $v"; done
    echo
    echo "${YELLOW}If a US spelling is dictated by an external interface${RESET}"
    echo "(CSS \`color\`, \`Cargo.toml\` \`license\` field, image crate"
    echo "\`ColorType\`, etc.) add the surrounding line to .baseline-hook-allow."
    FAIL=1
fi

if [[ ${#FUTUREVER_VIOLATIONS[@]} -gt 0 ]]; then
    echo
    echo "${RED}${BOLD}FUTURE-VERSION GATE: commit blocked${RESET}"
    echo
    echo "Staged additions to user-facing docs reference a future version."
    echo "Baseline rule: only the current release ships in the public docs."
    echo "Future-version references belong in the gitignored roadmap."
    echo
    for v in "${FUTUREVER_VIOLATIONS[@]}"; do echo "  $v"; done
    echo
    echo "${YELLOW}Match-pattern:${RESET} ${BLOCK_FUTURE_VERSIONS_REGEX}"
    echo "${YELLOW}Set in:${RESET} .baseline-hook-config"
    FAIL=1
fi

if [[ ${#STALEVER_WARNINGS[@]} -gt 0 ]]; then
    echo
    echo "${YELLOW}${BOLD}STALE-VERSION-REF: warnings (not blocking)${RESET}"
    echo
    echo "Staged additions in operator-facing surfaces reference a version more"
    echo "than 1 patch behind ${STALE_VERSION_CARGO_PATH}. Update the ref, or, if"
    echo "the ref is deliberately historical, leave it; the gate warns, it does"
    echo "not block."
    echo
    for v in "${STALEVER_WARNINGS[@]}"; do echo "  $v"; done
    echo
    echo "${YELLOW}Scope:${RESET} ${BLOCK_STALE_VERSION_REF_PATHS}"
    echo "${YELLOW}Toggle off:${RESET} BLOCK_STALE_VERSION_REF_ENABLED=0 in .baseline-hook-config"
fi

if [[ ${#SUPPLY_CHAIN_VIOLATIONS[@]} -gt 0 ]]; then
    echo
    echo "${RED}${BOLD}SUPPLY-CHAIN GATE: commit blocked${RESET}"
    echo
    echo "Staged file matches a real-world supply-chain attack signature"
    echo "(Shai-Hulud, GhostAction, chrono_anchor / time_calibrator)."
    echo
    for v in "${SUPPLY_CHAIN_VIOLATIONS[@]}"; do echo "  $v"; done
    echo
    echo "${YELLOW}If this is a legitimate install script or dep,${RESET}"
    echo "remove the credential-touching parts and use a CI-native"
    echo "secret-handling mechanism instead. Toggle via"
    echo "SUPPLY_CHAIN_ENABLED=0 in .baseline-hook-config to bypass."
    FAIL=1
fi

# 6. Documentation prompt-injection gate.
#
# Inspired by: Comment-and-Control attack class (April 2026) and the
# indirect-injection research showing that READMEs, AUPs, and docs
# can contain hidden instructions that an LLM consuming the repo will
# follow. We can't prevent all attacks (a sufficiently clever attacker
# embeds instructions in any prose), but we can catch the OBVIOUS
# HTML-comment instruction blocks.
DOC_INJECTION_VIOLATIONS=()
if [[ "$DOC_INJECTION_ENABLED" = "1" ]]; then
DOC_INJECTION_PATTERNS=(
    # HTML-comment-block carrying agent directives.
    '<!--[[:space:]]*(ASSISTANT|AGENT|AI|CLAUDE|GPT|COPILOT|GEMINI)[[:space:]]*(INSTRUCTIONS|DIRECTIVE)'
    # Hidden meta-comments common in indirect-injection PoCs.
    '<!--[[:space:]]*HUMAN[[:space:]]+READERS[[:space:]]+(PLEASE[[:space:]]+)?IGNORE'
    # Classic injection phrasing in docs (not just memory).
    '(ignore[[:space:]]+(all[[:space:]]+)?(previous|prior|above)[[:space:]]+instructions|when[[:space:]]+you[[:space:]]+next[[:space:]]+help[[:space:]]+with[[:space:]]+this[[:space:]]+codebase)'
)
# Fast pre-check first (TD-126): this gate has no content pre-filter and greps every pattern per
# line, so on a big commit it dominated the hook budget (3 greps per line). One joined grep over
# the whole diff decides whether to walk line by line at all.
DOC_INJECTION_JOINED=$(JOIN "${DOC_INJECTION_PATTERNS[@]}")
# TD-126 single-pass: one grep for an injection candidate over the annotated added lines.
while IFS=$'\t' read -r current_file line_no content; do
    # Per-project exemptions (config-driven; empty by default).
    if [[ -n "$DOC_INJECTION_EXEMPT_PATHS" ]] && path_exempt "$current_file" "$DOC_INJECTION_EXEMPT_PATHS"; then continue; fi
    case "$current_file" in
        *.md|*.markdown|*.adoc|README*|AUP*|CHANGELOG*|CONTRIBUTING*|SECURITY*) ;;
        *) continue ;;
    esac
    for p in "${DOC_INJECTION_PATTERNS[@]}"; do
        if echo "$content" | grep -qiE -e "$p"; then
            if ! is_allowlisted "$content"; then
                DOC_INJECTION_VIOLATIONS+=("${RED}${current_file}:${line_no}${RESET}  matched ${BOLD}${p}${RESET}")
                DOC_INJECTION_VIOLATIONS+=("    ${content:0:140}")
            fi
            break
        fi
    done
done < <(grep -iE -e "$DOC_INJECTION_JOINED" <<<"$ADDED_ANNOTATED")
fi

if [[ ${#DOC_INJECTION_VIOLATIONS[@]} -gt 0 ]]; then
    echo
    echo "${RED}${BOLD}DOC PROMPT-INJECTION GATE: commit blocked${RESET}"
    echo
    echo "Staged additions to docs contain agent-directed instructions or"
    echo "classic prompt-injection phrasing. Models the Comment-and-Control"
    echo "attack class (April 2026): a repo's README/AUP/docs read by an"
    echo "LLM contributor agent becomes attacker-controlled instruction."
    echo
    for v in "${DOC_INJECTION_VIOLATIONS[@]}"; do echo "  $v"; done
    echo
    echo "${YELLOW}Refactor:${RESET} prose can ASK readers (human or AI) to do"
    echo "things in plain language; it must not impersonate a system"
    echo "directive. Strip the marker tokens and rephrase."
    FAIL=1
fi

if [[ ${#LLM_TELLS_VIOLATIONS[@]} -gt 0 ]]; then
    echo
    echo "${RED}${BOLD}LLM-TELLS GATE: commit blocked${RESET}"
    echo
    echo "Staged additions to public docs match an LLM-tell pattern"
    echo "(baseline Section 21). Rewrite using specific language rather than"
    echo "AI rhetorical filler."
    echo
    for v in "${LLM_TELLS_VIOLATIONS[@]}"; do echo "  $v"; done
    echo
    echo "${YELLOW}If the word is genuinely the right choice (e.g. 'robust'"
    echo "in a structural-engineering context), add the line to"
    echo ".baseline-hook-allow with a one-line comment explaining why.${RESET}"
    echo "${YELLOW}Toggle off:${RESET} LLM_TELLS_ENABLED=0 in .baseline-hook-config"
    FAIL=1
fi

if [[ ${#EMDASH_VIOLATIONS[@]} -gt 0 ]]; then
    echo
    echo "${RED}${BOLD}EM-DASH GATE: commit blocked${RESET}"
    echo
    echo "Staged additions contain em dash (—) or prose en dash (–)."
    echo "Baseline Section 19: replace with the punctuation the sentence actually"
    echo "needs (\`: \`, \`, \`, \`; \`, full stop, or parentheses)."
    echo
    for v in "${EMDASH_VIOLATIONS[@]}"; do echo "  $v"; done
    echo
    echo "${YELLOW}If a particular line legitimately needs the dash${RESET}"
    echo "(narrow table, code block, deliberate stylistic choice with a"
    echo "comment explaining why), add an exception to .baseline-hook-allow."
    echo "${YELLOW}Toggle the gate off entirely:${RESET} EMDASH_ENABLED=0 in .baseline-hook-config"
    FAIL=1
fi

if [[ ${#WORKFLOW_VIOLATIONS[@]} -gt 0 ]]; then
    echo
    echo "${RED}${BOLD}WORKFLOW-SECURITY GATE: commit blocked${RESET}"
    echo
    echo "Staged GitHub Actions workflow matches a known-exploited pattern"
    echo "(pull_request_target, script injection, unpinned 3rd-party action)."
    echo
    for v in "${WORKFLOW_VIOLATIONS[@]}"; do echo "  $v"; done
    echo
    echo "${YELLOW}References:${RESET}"
    echo "  - Grafana breach (April 2025) — pull_request_target"
    echo "  - Fake CI Updates (March 2026) — same pattern"
    echo "  - tj-actions/changed-files (March 2025) — unpinned action"
    echo "${YELLOW}Toggle:${RESET} WORKFLOW_SECURITY_ENABLED=0 in .baseline-hook-config"
    FAIL=1
fi

if [[ ${#IP_PUBLISHABLE_VIOLATIONS[@]} -gt 0 ]]; then
    echo
    echo "${RED}${BOLD}PUBLISHABLE-CONTENT GATE: commit blocked${RESET}"
    echo
    echo "Files under a publishable path carry an internal marker that would"
    echo "render publicly. The Tier 1 allowlist does not exempt these; only the"
    echo "documented legit patterns (env var names, canonical licence names) do."
    echo
    for v in "${IP_PUBLISHABLE_VIOLATIONS[@]}"; do echo "  $v"; done
    echo
    echo "${YELLOW}Rewrite the copy, or extend IP_PUBLISHABLE_LEGIT_PATTERNS in"
    echo ".baseline-hook-config if the string is genuinely public-safe.${RESET}"
    FAIL=1
fi

if [[ ${#IP_VIOLATIONS[@]} -gt 0 ]]; then
    echo
    echo "${RED}${BOLD}IP-HYGIENE GATE: commit blocked${RESET}"
    echo
    echo "Staged additions contain a forbidden literal (internal path, infra"
    echo "identifier, planning marker, credential name, or the like) that must"
    echo "not land in this repo."
    echo
    for v in "${IP_VIOLATIONS[@]}"; do echo "  $v"; done
    echo
    echo "${YELLOW}Rewrite the text, add the file to IP_ALLOWLIST_PATHS in"
    echo ".baseline-hook-config with a reason, or (last resort) --no-verify.${RESET}"
    FAIL=1
fi

if [[ ${#AGPL_VIOLATIONS[@]} -gt 0 ]]; then
    echo
    echo "${RED}${BOLD}AGPL-HEADER GATE: commit blocked${RESET}"
    echo
    echo "These staged source files are missing the SPDX header line:"
    echo "  ${BOLD}${AGPL_HEADER_SPDX}${RESET}"
    echo
    for f in "${AGPL_VIOLATIONS[@]}"; do echo "  ${RED}${f}${RESET}"; done
    echo
    echo "${YELLOW}Add the header, or toggle AGPL_HEADER_ENABLED=0 in .baseline-hook-config.${RESET}"
    FAIL=1
fi

[[ $FAIL -eq 1 ]] && { echo; exit 1; }

# 9. Pre-commit clippy (opt-in). Runs only when the commit touches Rust and
# only if enabled; surfaces warnings before the commit lands. Absorbed from the
# dokima hook. Off by default because a cold workspace clippy is slow.
if [[ "$PRECOMMIT_CLIPPY_ENABLED" = "1" ]]; then
    if git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep -qE '\.rs$'; then
        echo "${YELLOW}pre-commit clippy: cargo clippy --workspace --all-targets -- -D warnings${RESET}"
        clippy_dir="${PRECOMMIT_CLIPPY_DIR:-.}"
        if ! ( cd "$clippy_dir" && cargo clippy --workspace --all-targets -- -D warnings 2>&1 | tail -20 ); then
            echo
            echo "${RED}${BOLD}CLIPPY GATE: commit blocked${RESET}"
            echo "Fix the warnings above, re-stage, and retry."
            echo "${YELLOW}Disable for one commit: PRECOMMIT_CLIPPY_ENABLED=0 git commit ...${RESET}"
            exit 1
        fi
    fi
fi

# ── Project-specific gates ────────────────────────────────────────────────────
# Every executable script in .githooks/local.d/ runs here, in name order, as a
# SUBPROCESS. A non-zero exit blocks the commit.
#
# This exists because there was previously nowhere to put a gate that only one
# project needs. career-ops needed a check comparing a committed rendered view
# against what its renderer produces from SQLite, no config knob can express
# that, so it went inline in the managed body of this file. Once a project edits
# the managed body, the file is no longer safely replaceable: a later wholesale
# copy silently deleted that guard, and the guard was not running at all until
# it was noticed. Subprocess, not `source`, for the same reason the config is
# parsed rather than executed: a project gate should not be able to change how
# this hook behaves.
#
# Anything here is the PROJECT's, never overwritten by propagation.
if [ -d "$PWD/.githooks/local.d" ]; then
    for _local_gate in "$PWD/.githooks/local.d"/*.sh; do
        [ -x "$_local_gate" ] || continue
        if ! "$_local_gate"; then
            echo
            echo "${RED}${BOLD}PROJECT GATE: commit blocked${RESET}"
            echo "Failed: ${_local_gate#"$PWD/"}"
            echo "That gate belongs to this project, not to the shared baseline."
            exit 1
        fi
    done
fi

exit 0
