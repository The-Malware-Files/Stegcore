#!/usr/bin/env bash
#
# pre-push: branch protection + secret sweep + large-file guard
#           + optional scoped Rust gates.
#
# Branch protection has two modes, selected by PROTECTED_BRANCH_MODE in
# .baseline-hook-config (default pr-only):
#   pr-only    Refuses any direct push to main/master (branch + PR workflow).
#   ff-promote Allows strict fast-forward pushes to main/master (the dev -> main
#              promote workflow); refuses only force-push / non-fast-forward.
# Both modes refuse any push to a remote named 'upstream' (by convention the
# source repo you never push to directly). Sweeps the commits being pushed for
# secret-shaped content. Blocks files over 5 MB without explicit confirmation.
# If the repo declares versions in multiple files they must agree (toggle with
# VERSION_DRIFT_ENABLED). If the repo is a Rust workspace, runs fmt + clippy
# scoped to the changed files.
#
# All customisation lives in .baseline-hook-config so this file stays
# byte-identical across every repo. Implements Section 8 and Section 13 of the
# engineering baseline.
#
# Bypass: git push --no-verify   (last resort).

set -eu

RED=$(tput setaf 1 2>/dev/null || true)
YELLOW=$(tput setaf 3 2>/dev/null || true)
GREEN=$(tput setaf 2 2>/dev/null || true)
BOLD=$(tput bold 2>/dev/null || true)
RESET=$(tput sgr0 2>/dev/null || true)

# ── Baseline config loading (parsed, never executed) ────────────────────────
#
# `.baseline-hook-config` used to be `source`d. That handed arbitrary shell to
# anyone who could land that file in the repo, executed on the developer's own
# machine on every commit and every push. In a repo that takes outside
# contributions a documentation-shaped pull request was a code-execution hole.
#
# The grammar below is deliberately tiny and covers every shape the existing
# project configs use:
#
#     NAME=value        NAME='literal'    NAME="expanded $OTHER_KEY"
#     NAME=(a b c)      NAME=(            # one element per line
#                         'regex with ) inside'
#                       )
#
# Quoting follows shell rules, because the configs rely on them: a
# single-quoted value is literal, an unquoted or double-quoted value may
# reference an earlier key as $NAME or ${NAME}. Only names already assigned by
# this same file are substituted, so there is no environment leakage. There is
# no command substitution, no globbing and no word splitting beyond the array
# tokeniser: `$(...)` and backticks are data, because nothing is ever executed.
#
# A line the grammar does not accept is refused loudly. A config that silently
# stopped applying is worse than one that fails.

# Names that must never be assignable from a project file, because they change
# how this shell itself behaves. Everything else is allowed: the security
# property comes from never executing the file, not from enumerating knobs, and
# an allowlist that gates assignment would silently drop a real setting the day
# the baseline gains a new one.
BHC_BLOCKED_KEYS="
PATH IFS BASH_ENV ENV CDPATH LD_PRELOAD LD_LIBRARY_PATH SHELLOPTS BASHOPTS
PS1 PS2 PS4 PROMPT_COMMAND GLOBIGNORE HISTFILE FUNCNAME
BHC_BLOCKED_KEYS BHC_KNOWN_KEYS BHC_EXEC_KEYS
"

# Knobs whose VALUE reaches an exec or a build. The NAME is harmless, so a
# denylist of dangerous names never catches these: `INVARIANT_BIN=./evil.sh` is
# a documented, allowlisted knob used exactly as designed, and pre-push runs it.
# Demonstrated end to end on 2026-07-26 (arbitrary code execution as the operator
# on `git push`), which is why this is a separate list rather than more entries
# on the one above: the two lists answer different questions. BLOCKED asks "may
# this name be assigned at all"; EXEC asks "may a repo choose this value".
#
# These stay settable from the ENVIRONMENT, where the operator sets them, and are
# refused only from the parsed file, which any repo can ship.
#
# CLIPPY_PACKAGES and STALE_VERSION_CARGO_PATH are deliberately NOT here. Both
# are in live use, and neither escalates: clippy already compiles the repo's own
# build.rs whenever it runs, so a repo that can set them can already run code by
# the same path with or without the knob.
BHC_EXEC_KEYS="
INVARIANT_BIN INVARIANT_REPO PRECOMMIT_CLIPPY_DIR
"

# The two names above are the load-bearing ones and were missing until
# 2026-07-26. Without them the blocklist could disarm itself:
#
#     BHC_BLOCKED_KEYS=          <- allowed, because it was not on its own list
#     PATH=/tmp/attacker         <- now allowed, because the list is empty
#
# and every command the hook runs afterwards (git, cargo, grep) resolves through
# an attacker-controlled directory. Demonstrated end to end before fixing: a
# fake `git` on that PATH executed.
#
# A blocklist that can be edited by the thing it is guarding against is not a
# blocklist. The general rule this encodes: any name the parser's own security
# decisions read must be unassignable from the file being parsed.
#
# `_BHC_ELEMS` and `_BHC_CLOSED` are the scanner's scratch variables. They are
# reset before every use, so assigning them was measured to be harmless, and
# they are listed anyway: the invariant worth having is the flat one, "nothing
# the parser itself uses can be set by the file it is parsing", because that
# survives someone later using the scratch variables differently.

# Known baseline knobs. Used only to flag a likely typo; an unlisted name is
# still assigned, with a warning, so a newer config on an older hook keeps
# working.
BHC_KNOWN_KEYS="
AGPL_HEADER_ENABLED AGPL_HEADER_SPDX
BLOCK_FUTURE_VERSIONS_ENABLED BLOCK_FUTURE_VERSIONS_PATHS BLOCK_FUTURE_VERSIONS_REGEX
BLOCK_STALE_VERSION_REF_ENABLED BLOCK_STALE_VERSION_REF_PATHS
BRE_ENABLED BRE_EXEMPT_PATHS
CLIPPY_PACKAGES CODENAME_ENABLED
DOC_INJECTION_EXEMPT_PATHS
EMDASH_ENABLED EMDASH_EXEMPT_PATHS
IP_ALLOWLIST_PATHS IP_FORBIDDEN_REGEX IP_FORBIDDEN_REGEX_CI IP_HYGIENE_ENABLED
IP_PUBLISHABLE_LEGIT_PATTERNS IP_PUBLISHABLE_PATHS
LLM_TELLS_ENABLED
PANEL_GATE_ENABLED
PRECOMMIT_CLIPPY_DIR PRECOMMIT_CLIPPY_ENABLED
PRIVATE_DIRS PROTECTED_BRANCH_MODE
PRIVATE_REMOTES PRIVATE_PATHS PUBLISHED_TOOLCHAIN
PRIVATE_NAME_SOURCES PRIVATE_NAME_MIN_STEM
INVARIANT_GATE_ENABLED INVARIANT_BIN INVARIANT_REPO
STALE_VERSION_CARGO_PATH SUPPLY_CHAIN_ENABLED
VERSION_FILES VERSION_DRIFT_ENABLED WORKFLOW_SECURITY_ENABLED
CLIPPY_ENABLED GITLEAKS_ENABLED
_SKILLS_VENDORED
"

_bhc_key_known() {
    local k
    for k in $BHC_KNOWN_KEYS; do [ "$k" = "$1" ] && return 0; done
    return 1
}

_bhc_key_blocked() {
    local k
    # Every name the parser itself uses lives under the _bhc_ / _BHC_ prefix, so
    # reserving the prefix is the whole invariant in one line, rather than a list
    # that has to be kept in step with the code. Three separate holes were found
    # on 2026-07-26 because the list was maintained by hand and the code moved:
    # `_bhc_a` (a nameref local, circular-reference crash), `arr_name` (the loop's
    # continuation variable, read ABOVE this check, which let a config write PATH
    # and silently disable five gates), and `failed` (the error counter, so a
    # refusal still returned success).
    #
    # SKIP_* is reserved for the same reason, added 2026-08-11 after it was
    # demonstrated end to end: a repo shipping one line,
    #
    #     SKIP_PRIVATE_REMOTE_GATE=1
    #
    # in its own .baseline-hook-config pushed private/ to a public remote. Every
    # gate here reads its bypass as ${SKIP_...:-0}, and this parser assigns any
    # name it does not block, so the committed file could answer the question
    # ADR 67 says config must never answer: not WHAT is checked, but WHETHER.
    # The bypasses are meant to be environment-only, set by the operator at the
    # moment of the push, with a reason. A prefix rule rather than a list,
    # because a list goes stale the day a new gate is added and the hole is
    # silent when it does.
    # Widened 2026-08-11 from SKIP_ alone. Reserving the names I happened to know
    # about left three more per-push escapes assignable from the committed file:
    # ALLOW_PROTECTED_DELETE, BASELINE_LARGE_FILE_OK and BASELINE_VERSION_DRIFT_OK,
    # so one config line still let the pushed tree delete main, pass the large
    # file guard, or pass version drift. The rule is the capability, not the
    # roster: any name that answers "should this check be enforced" is
    # environment only. Verified before landing that no repo on the fleet sets
    # either prefix.
    case "$1" in _bhc_*|_BHC_*|SKIP_*|ALLOW_*|BASELINE_*) return 0 ;; esac
    for k in $BHC_BLOCKED_KEYS; do [ "$k" = "$1" ] && return 0; done
    return 1
}

_bhc_key_exec() {
    local k
    for k in $BHC_EXEC_KEYS; do [ "$k" = "$1" ] && return 0; done
    return 1
}

# Substitute $NAME / ${NAME} for keys this file has already assigned. Unknown
# or unset names are left verbatim, matching nothing rather than guessing.
_bhc_expand() {
    local s="$1" out='' i=0 c nm rest
    # NOTE: ${#s} must be computed after s is assigned. Bash expands an entire
    # `local a=.. b=..` line before performing any of its assignments, so
    # `local s="$1" n=${#s}` silently yields n=0.
    local n=${#s}
    while [ "$i" -lt "$n" ]; do
        c="${s:i:1}"
        if [ "$c" != '$' ]; then out+="$c"; i=$((i + 1)); continue; fi
        rest="${s:i+1}"
        if [ "${rest:0:1}" = '{' ]; then
            nm="${rest:1}"; nm="${nm%%\}*}"
            if [ "${rest#*\}}" != "$rest" ] && _bhc_key_known "$nm"; then
                out+="${!nm-}"; i=$((i + 3 + ${#nm})); continue
            fi
        else
            nm="${rest%%[!A-Za-z0-9_]*}"
            if [ -n "$nm" ] && _bhc_key_known "$nm"; then
                out+="${!nm-}"; i=$((i + 1 + ${#nm})); continue
            fi
        fi
        out+="$c"; i=$((i + 1))
    done
    printf '%s' "$out"
}

# Character scanner shared by scalars and array bodies. Walks TEXT honouring
# shell quoting, appends finished elements to _BHC_ELEMS, and sets _BHC_CLOSED
# when it consumes a `)` that sits outside quotes.
_bhc_scan() {
    local s="$1" i=0 c q='' cur='' started=0 literal=0
    local n=${#s}   # see the note in _bhc_expand: must follow s's assignment
    _bhc_flush() {
        if [ "$started" = 1 ]; then
            if [ "$literal" = 1 ]; then _BHC_ELEMS+=("$cur")
            else _BHC_ELEMS+=("$(_bhc_expand "$cur")"); fi
        fi
        cur=''; started=0; literal=0
    }
    while [ "$i" -lt "$n" ]; do
        c="${s:i:1}"; i=$((i + 1))
        if [ -n "$q" ]; then
            if [ "$c" = "$q" ]; then q=''; else cur+="$c"; fi
            continue
        fi
        case "$c" in
            "'") q="'"; started=1; [ -z "$cur" ] && literal=1 ;;
            '"') q='"'; started=1 ;;
            ')') _bhc_flush; _BHC_CLOSED=1; return 0 ;;
            '#') [ "$started" = 0 ] && return 0; cur+="$c" ;;
            ' '|$'\t') _bhc_flush ;;
            *) cur+="$c"; started=1 ;;
        esac
    done
    _bhc_flush
    return 0
}

_bhc_set_scalar()  { printf -v "$1" '%s' "$2"; }
_bhc_reset_array() { local -n _bhc_a="$1"; _bhc_a=(); }
_bhc_push_array()  { local -n _bhc_a="$1"; _bhc_a+=("$2"); }

# Parse FILE and assign the knobs it declares. Non-zero (and a message on
# stderr) when the file contains a line the grammar does not accept.
load_baseline_hook_config() {
    # Every local here is _bhc_-prefixed and therefore unassignable from the file
    # being parsed (see _bhc_key_blocked). Before 2026-07-26 these were plain
    # names, and `printf -v` in _bhc_set_scalar writes through dynamic scoping,
    # so a config line `arr_name=PATH` or `failed=0` reached straight into this
    # function's frame.
    local _bhc_file="$1"
    [ -f "$_bhc_file" ] || return 0
    local _bhc_line _bhc_lineno=0 _bhc_key _bhc_val _bhc_trimmed _bhc_arr='' _bhc_e
    local -i _bhc_failed=0

    while IFS= read -r _bhc_line || [ -n "$_bhc_line" ]; do
        _bhc_lineno=$((_bhc_lineno + 1))
        _bhc_trimmed="${_bhc_line#"${_bhc_line%%[![:space:]]*}"}"

        if [ -n "$_bhc_arr" ]; then                    # continuing NAME=( ...
            _BHC_ELEMS=(); _BHC_CLOSED=0
            _bhc_scan "$_bhc_trimmed"
            for _bhc_e in "${_BHC_ELEMS[@]}"; do _bhc_push_array "$_bhc_arr" "$_bhc_e"; done
            [ "$_BHC_CLOSED" = 1 ] && _bhc_arr=''
            continue
        fi

        case "$_bhc_trimmed" in ''|'#'*) continue ;; esac

        case "$_bhc_trimmed" in
            [A-Za-z_]*=*) _bhc_key="${_bhc_trimmed%%=*}"; _bhc_val="${_bhc_trimmed#*=}" ;;
            *) printf '%s:%d: not an assignment: %s\n' "$_bhc_file" "$_bhc_lineno" "$_bhc_trimmed" >&2
               _bhc_failed=1; continue ;;
        esac

        case "$_bhc_key" in *[!A-Za-z0-9_]*)
            printf '%s:%d: bad key name: %s\n' "$_bhc_file" "$_bhc_lineno" "$_bhc_key" >&2
            _bhc_failed=1; continue ;;
        esac

        if _bhc_key_blocked "$_bhc_key"; then
            printf '%s:%d: refusing to set %s from a project config\n' \
                   "$_bhc_file" "$_bhc_lineno" "$_bhc_key" >&2
            _bhc_failed=1; continue
        fi

        if _bhc_key_exec "$_bhc_key"; then
            printf '%s:%d: refusing to set %s from a project config: its value is\n' \
                   "$_bhc_file" "$_bhc_lineno" "$_bhc_key" >&2
            printf '  executed, so it may only come from your environment, not from a\n' >&2
            printf '  file any repository can ship. Export it in your shell instead.\n' >&2
            _bhc_failed=1; continue
        fi

        # An unrecognised name is still assigned (so a config written against a
        # newer baseline keeps working on an older hook) but is flagged, because
        # in practice the usual cause is a typo in a knob name and a silently
        # ignored gate setting is the worst outcome here.
        _bhc_key_known "$_bhc_key" || \
            printf 'warning: %s:%d: %s is not a known baseline knob (typo?)\n' \
                   "$_bhc_file" "$_bhc_lineno" "$_bhc_key" >&2

        if [ "${_bhc_val:0:1}" = '(' ]; then             # array assignment
            _bhc_reset_array "$_bhc_key"
            _BHC_ELEMS=(); _BHC_CLOSED=0
            _bhc_scan "${_bhc_val:1}"
            for _bhc_e in "${_BHC_ELEMS[@]}"; do _bhc_push_array "$_bhc_key" "$_bhc_e"; done
            [ "$_BHC_CLOSED" = 1 ] || _bhc_arr="$_bhc_key"
        else                                            # scalar assignment
            _BHC_ELEMS=(); _BHC_CLOSED=0
            _bhc_scan "$_bhc_val"
            _bhc_set_scalar "$_bhc_key" "${_BHC_ELEMS[0]-}"
        fi
    done < "$_bhc_file"

    if [ -n "$_bhc_arr" ]; then
        printf '%s: unterminated array assignment for %s\n' "$_bhc_file" "$_bhc_arr" >&2
        _bhc_failed=1
    fi
    return $_bhc_failed
}

remote="$1"

# Git sends an all-zeros sha for a brand-new (or deleted) ref. The zeros
# string must match the hash length in use, so derive it from a real hash
# rather than hard-coding 40 zeros (SHA-256 repos use 64).
zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')

# ── Never push to 'upstream' ────────────────────────────────────────────────
if [ "$remote" = "upstream" ]; then
    echo "${RED}${BOLD}REFUSED${RESET}: push to the 'upstream' remote."
    echo "By convention 'upstream' is the source repo. Push to 'origin'"
    echo "and let changes reach upstream through a pull request."
    exit 1
fi

# ── Source project config (idempotent; pre-commit may have done it already)
repo_root=$(git rev-parse --show-toplevel)
if [[ -f "$repo_root/.baseline-hook-config" ]]; then
    if ! load_baseline_hook_config "$repo_root/.baseline-hook-config"; then
        echo "${RED}${BOLD}REFUSED${RESET}: .baseline-hook-config has a line that is not a setting."
        echo "The baseline hooks now parse that file instead of executing it, so a"
        echo "stray command there can no longer run on your machine. Remove the lines"
        echo "named above, or express them as NAME=value / NAME=(...)."
        exit 1
    fi
fi
CODENAME_ENABLED="${CODENAME_ENABLED:-1}"
PROTECTED_BRANCH_MODE="${PROTECTED_BRANCH_MODE:-pr-only}"

# ── Read the ref updates from stdin ─────────────────────────────────────────
# Each line: <local_ref> <local_sha> <remote_ref> <remote_sha>
non_ff_to_protected=0
direct_to_protected=0
delete_protected=0
PROMOTE_SHAS=()
PUSH_BRANCHES=()
RELEASE_TAGS_MISSING_CODENAME=()
PUSH_LOCAL=()
PUSH_REMOTE=()
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "${remote_ref:-}" ] && continue
    branch="${remote_ref#refs/heads/}"
    # Refuse DELETING a protected branch (local_sha all zeros on a heads ref is
    # a deletion). Skipping deleted refs unconditionally would let
    # `git push origin :main` wipe the protected branch straight past the gate.
    # Override with recorded reason: ALLOW_PROTECTED_DELETE=1.
    if { [ "$branch" = "main" ] || [ "$branch" = "master" ]; } \
        && [ "$local_sha" = "$zero" ] && [ "${ALLOW_PROTECTED_DELETE:-0}" != "1" ]; then
        delete_protected=1
    fi
    # A deleted ref (local_sha all zeros) has nothing further to scan.
    [ "$local_sha" = "$zero" ] && continue
    # Destination branch names, for the two-branch gate below. Guarded on the
    # refs/heads/ prefix because `branch` is only a branch name for heads refs;
    # for a tag it still holds the full refs/tags/... path and would be judged
    # as a stray branch.
    if [ "$remote_ref" != "${remote_ref#refs/heads/}" ]; then
        PUSH_BRANCHES+=("$branch")
    fi
    # Branch protection on main + master, per PROTECTED_BRANCH_MODE.
    if [ "$branch" = "main" ] || [ "$branch" = "master" ]; then
        # A promotion to the protected branch is the moment the panel and
        # planning gates bite (ADR 63). Collected here, checked after the
        # cheaper protections below have had their say, so the operator sees
        # "you cannot force-push" before "you have not run the panel".
        PROMOTE_SHAS+=("$local_sha")
        case "$PROTECTED_BRANCH_MODE" in
            ff-promote)
                # FF pushes allowed (the dev -> main promote pattern). Brand-new
                # branches (remote_sha all zeros) are allowed. Non-FF is refused.
                if [ "$remote_sha" != "$zero" ] \
                   && ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
                    non_ff_to_protected=1
                fi
                ;;
            *)
                # pr-only (default): refuse any direct push to a protected
                # branch; land changes through a pull request.
                direct_to_protected=1
                ;;
        esac
    fi
    # Release-tag codename gate (CLAUDE.md Section 22).
    # Annotated `v*` tags must carry a `Codename:` line. Override:
    # SKIP_TAG_CODENAME=1 git push (recorded reason required).
    # Project may disable via CODENAME_ENABLED=0 in .baseline-hook-config.
    if [[ "$remote_ref" == refs/tags/v* ]] \
        && [ "${SKIP_TAG_CODENAME:-0}" != "1" ] \
        && [ "$CODENAME_ENABLED" != "0" ]; then
        tag_name="${remote_ref#refs/tags/}"
        # Only inspect annotated tags (lightweight tags point at commits).
        obj_type=$(git cat-file -t "$local_sha" 2>/dev/null || echo "")
        if [ "$obj_type" = "tag" ]; then
            tag_msg=$(git cat-file -p "$local_sha" 2>/dev/null | awk 'BEGIN{p=0} /^$/{p=1; next} p{print}')
            if ! echo "$tag_msg" | grep -qiE '^Codename:[[:space:]]*[^[:space:]]'; then
                RELEASE_TAGS_MISSING_CODENAME+=("$tag_name")
            fi
        fi
    fi
    PUSH_LOCAL+=("$local_sha")
    PUSH_REMOTE+=("$remote_sha")
done

if [ "$delete_protected" -eq 1 ]; then
    echo "${RED}${BOLD}REFUSED${RESET}: deleting a protected branch (main/master)."
    echo "Deleting the protected branch is almost never intended and cannot be"
    echo "undone by a fast-forward. If you genuinely mean it:"
    echo "  ALLOW_PROTECTED_DELETE=1 git push origin :<branch>"
    exit 1
fi

if [ "$direct_to_protected" -eq 1 ]; then
    echo "${RED}${BOLD}REFUSED${RESET}: direct push to main/master."
    echo "This repo uses the branch + pull-request workflow"
    echo "(PROTECTED_BRANCH_MODE=pr-only). Push a feature branch and"
    echo "open a PR instead."
    exit 1
fi

if [ "$non_ff_to_protected" -eq 1 ]; then
    echo "${RED}${BOLD}REFUSED${RESET}: non-fast-forward push to main/master."
    echo "Force-push and history rewrites are blocked. Either:"
    echo "  - merge the remote into your branch first (so the push becomes FF), or"
    echo "  - open a revert PR if you genuinely need to roll history back."
    exit 1
fi

if [ "${#RELEASE_TAGS_MISSING_CODENAME[@]}" -gt 0 ]; then
    echo "${RED}${BOLD}REFUSED${RESET}: release tag missing a Codename: line."
    echo
    echo "Per CLAUDE.md Section 22, annotated v* tags carry a human codename"
    echo "chosen by the user (typically a TV series / anime / film they"
    echo "are currently watching). The codename belongs in the tag"
    echo "message as a 'Codename: <name>' line near the top."
    echo
    echo "Tags failing the check:"
    for t in "${RELEASE_TAGS_MISSING_CODENAME[@]}"; do
        echo "  - ${BOLD}${t}${RESET}"
    done
    echo
    echo "Fix:"
    echo "  git tag -d <tag>"
    echo "  git tag -a <tag> -m \"<tag> — <Codename>\" -m \"Codename: <Codename>\""
    echo "  git push origin <tag>"
    echo
    echo "Bypass (last resort, with recorded reason):"
    echo "  SKIP_TAG_CODENAME=1 git push --tags"
    exit 1
fi

# ── Where the delegated gate fragments live ─────────────────────────────────
# NOT always .githooks/. A third-party clone is installed with
# core.hooksPath=<git-common-dir>/baseline-hooks, so that `git clean -xfd`
# cannot delete the gates; resolving fragments against $repo_root/.githooks
# there finds nothing, every delegated gate skips on its `-x` guard, and the
# push proceeds ungated. That is silent, and it is the precise failure the
# third-party path was built to prevent.
#
# $0 is the hook git actually invoked, so its directory is where the fragments
# were installed alongside it. The .githooks fallback keeps repos that predate
# this working unchanged.
hook_dir=$(cd "$(dirname "$0")" 2>/dev/null && pwd) || hook_dir=""

# A fragment that is PRESENT but not executable, or ABSENT from a repo that has
# been onboarded, is a refusal rather than a skip.
#
# The `-x` guard exists so this hook is a no-op in a repo that never installed
# the fragments, and that is still right. But it also meant `chmod -x` on one
# file removed a gate in total silence while the push printed "all gates
# passed". Deleting the private-material gate was a supported, invisible way to
# turn it off.
#
# `.baseline-version` is the installer's own record that this repo is onboarded,
# so it is the honest line between "we never had this" and "we had it and it is
# gone".
_onboarded=0
[ -f "$repo_root/.baseline-version" ] && _onboarded=1

gate_frag() {
    local _name="$1" _p
    for _p in "${hook_dir:+$hook_dir/$_name}" "$repo_root/.githooks/$_name"; do
        [ -n "$_p" ] || continue
        if [ -x "$_p" ]; then printf '%s\n' "$_p"; return 0; fi
        if [ -e "$_p" ]; then
            echo "${RED}${BOLD}REFUSED${RESET}: $_name exists but is not executable, so git would skip it silently." >&2
            echo "  Fix: chmod +x $_p" >&2
            exit 1
        fi
    done
    if [ "$_onboarded" = 1 ]; then
        echo "${RED}${BOLD}REFUSED${RESET}: $_name is missing from an onboarded repo." >&2
        echo "  This repo carries .baseline-version, so the gate was installed and is now gone." >&2
        echo "  Repair: run tools/claude-setup/install-project.sh here." >&2
        exit 1
    fi
    return 0
}

# ── Two-branch gate: main and dev, nothing else (operator, 2026-07-31) ──────
# Runs before the promotion gate so a stray branch is refused on its name
# alone, without first spending a panel-artefact scan on a push that was never
# going to be allowed. Same file-per-gate shape as the promotion gate, and for
# the same reason: one artefact to propagate across the fleet rather than a
# hand-patch of a 900-line hook in each repo.
_bg=$(gate_frag branch-gate.sh)
if [ "${#PUSH_BRANCHES[@]}" -gt 0 ] && [ -n "$_bg" ]; then
    "$_bg" "${PUSH_BRANCHES[@]}" || exit 1
fi

# ── Doc-drift gate (F-9 from the 2026-08-03 panel) ──────────────────────────
# The check existed and was wired only into the SessionStart briefing, which
# means it advised and never refused. It was red at HEAD for five commits while
# saying so once a session, to a reader who had no obligation to act. An
# advisory that everyone has learned to scroll past is not a gate.
#
# Guarded on the script existing, so this is a no-op in every repo that does not
# ship it, in the same file-per-gate shape as the two gates below.
#
# Not switchable from .baseline-hook-config, per ADR 67: config may say what is
# checked, never whether. Bypass is environment-only and expects a reason:
#   SKIP_DOC_DRIFT=1 git push        # reason: <why the docs may lag this push>
if [ "${SKIP_DOC_DRIFT:-0}" != "1" ] \
   && [ -x "$repo_root/scripts/hooks/check-doc-drift.py" ]; then
    # A missing interpreter is not a pass. Guarding on `command -v python3`
    # meant a machine without it skipped this gate and printed success, which is
    # the failure mode this whole gate ladder exists to refuse.
    if ! command -v python3 >/dev/null 2>&1; then
        echo "REFUSED: check-doc-drift.py is installed here but python3 is not." >&2
        echo "  A check that cannot run has not passed. Install python3, or" >&2
        echo "  remove the gate deliberately." >&2
        exit 1
    fi
    if ! dd_out="$(python3 "$repo_root/scripts/hooks/check-doc-drift.py" 2>&1)"; then
        printf '%s\n' "$dd_out"
        echo
        echo "DOC-DRIFT GATE: push blocked"
        echo "  The docs no longer describe the tree they document."
        echo "  Fix the count or the index named above, then push again."
        echo "  Last resort, with a reason: SKIP_DOC_DRIFT=1 git push"
        exit 1
    fi
fi

# ── Claims gate: documents that stopped being true ──────────────────────────
# The doc-drift gate above is Hephaestus-only: it hardcodes that project's ADR
# log and crate table, so it is a no-op in the other thirteen repos, all of which
# drift the same way. This is the portable half.
#
# A repo declares what it asserts about itself in .baseline-claims.toml; the
# gate measures each fact from the tree and refuses a push where a document
# disagrees, or where two documents disagree with each other. A repo with no
# such file declares nothing and passes, which is what makes this safe to ship
# everywhere at once.
#
# Exit 2 means a check could not run (a pattern went blind, a file vanished) and
# is refused just as firmly as exit 1. A gate whose regex silently stopped
# matching reports success forever, which is worse than not having it.
#
# Not switchable from .baseline-hook-config, per ADR 67: config may say what is
# checked, never whether. Bypass is environment-only and expects a reason:
#   SKIP_CLAIMS_GATE=1 git push      # reason: <why the docs may lag this push>
_cg=$(gate_frag claims-gate.py)
if [ "${SKIP_CLAIMS_GATE:-0}" != "1" ] && [ -n "$_cg" ]; then
    # Same rule as the doc-drift gate above: no interpreter is a refusal, not a
    # silent skip.
    if ! command -v python3 >/dev/null 2>&1; then
        echo "REFUSED: claims-gate.py is installed here but python3 is not." >&2
        echo "  A check that cannot run has not passed." >&2
        exit 1
    fi
    if ! cg_out="$(python3 "$_cg" 2>&1)"; then
        printf '%s\n' "$cg_out"
        echo
        echo "CLAIMS GATE: push blocked"
        echo "  A document no longer describes the tree it documents, or two"
        echo "  documents disagree. The true value is named above."
        echo "  Fix the document, or the claim in .baseline-claims.toml if the"
        echo "  wording moved on."
        echo "  Last resort, with a reason: SKIP_CLAIMS_GATE=1 git push"
        exit 1
    fi
fi

# ── Promotion gate: the HARD half of the panel + planning gates (ADR 63) ────
# Only fires on a push to main/master, so routine dev work is untouched. Kept in
# its own file for the same reason the private-material gate is: this hook is
# supposed to be byte-identical across the fleet and never has been, so a gate
# that lives in one small script is one artefact to replace rather than twelve
# hand-patched copies.
#
# Deliberately NOT switchable from .baseline-hook-config. Per ADR 67 config may
# say what is checked, never whether checking happens; a gate the pushed tree
# can disable is not a gate. Both bypasses are environment-only.
_pg=$(gate_frag promotion-gate.sh)
if [ "${#PROMOTE_SHAS[@]}" -gt 0 ] && [ -n "$_pg" ]; then
    "$_pg" "${PROMOTE_SHAS[@]}" || exit 1
fi

[ "${#PUSH_LOCAL[@]}" -eq 0 ] && exit 0

# ── Private-material gate (deny-first, per remote) ──────────────────────────
# Delegated to a small shared script rather than inlined here. This hook is
# meant to stay byte-identical everywhere and has not managed it: as of
# 2026-07-26 there are five field variants across twelve repos, so a fix landed
# here reaches whichever copies someone remembers to patch. A gate that lives in
# its own file is one small artefact to replace, and can be diffed at a glance.
# See that file's header for why the gate exists at all.
# ADR 67: the bypass is environment-only. There is deliberately no config key
# that turns this off, because a committed switch on the one gate whose failure
# cannot be recalled is a switch that will eventually be flipped and forgotten.
_prg=$(gate_frag private-remote-gate.sh)
if [ "${SKIP_PRIVATE_REMOTE_GATE:-0}" != "1" ] && [ -n "$_prg" ]; then
    PRG_PAIRS=()
    prg_i=0
    while [ "$prg_i" -lt "${#PUSH_LOCAL[@]}" ]; do
        PRG_PAIRS+=("${PUSH_LOCAL[$prg_i]}:${PUSH_REMOTE[$prg_i]}")
        prg_i=$(( prg_i + 1 ))
    done
    # PUBLISHED_TOOLCHAIN joined this list on 2026-08-11. The gate has read it
    # since the floor landed, but pre-push never passed it, and passing
    # PRIVATE_REMOTES unconditionally also meant the gate's own config-parsing
    # fallback never ran (it is guarded on that name being unset). So the knob
    # was inert by two independent routes: a repo could declare its toolchain
    # public and still be refused, with the only working escape being
    # SKIP_PRIVATE_REMOTE_GATE=1, which disables private/, catastrophic/,
    # OPERATOR_ACTIONS.md and .claude at the same time.
    #
    # That is the worst possible shape for a gate. A narrow, reviewable, per
    # path escape that does not work is a machine for teaching people to reach
    # for the total bypass, and seven repos are queued to make exactly this
    # decision.
    PRIVATE_REMOTES="${PRIVATE_REMOTES:-}" \
    PRIVATE_PATHS="${PRIVATE_PATHS:-}" \
    PUBLISHED_TOOLCHAIN="${PUBLISHED_TOOLCHAIN:-}" \
        "$_prg" "$remote" "${PRG_PAIRS[@]}" || exit 1
fi

# ── Resolve the exact commits being pushed ──────────────────────────────────
# Updated branch: the commits between the old and new remote tip.
# New branch:     the commits on this branch not present on any remote.
COMMITS=()
i=0
while [ "$i" -lt "${#PUSH_LOCAL[@]}" ]; do
    ls="${PUSH_LOCAL[$i]}"
    rs="${PUSH_REMOTE[$i]}"
    if [ "$rs" = "$zero" ]; then
        # `--not --remotes` excludes anything already on ANY remote ref, and
        # that includes the autosave refs under wip/. The autosave commits every
        # few minutes with hooks skipped and force-pushes to its own ref, so by
        # the time a branch is pushed for real its commits look "already
        # published" and the sweeps below scan an empty set. Measured on
        # 2026-07-26: a probe branch resolved to zero commits because
        # origin/wip/chronos/<branch> already held it.
        #
        # A private safety-net ref is not publication. Exclude those refs from
        # the "already known" set so the content is still scanned.
        #
        # Scoped to the remote being pushed to, NOT every remote. Reading all of
        # refs/remotes was a hole, demonstrated end to end on 2026-08-11: the
        # autosave pushes with --no-verify every ten minutes, so a branch is
        # already present on the hub unscanned; a later ordinary push of that
        # same branch to a second remote then resolved ZERO commits, printed
        # "nothing new to scan; gates passed" and skipped the secret sweep,
        # gitleaks, the large-file guard, the publishable-content sweep, version
        # drift, fmt and clippy. An AKIA-shaped string reached the second remote.
        #
        # private-remote-gate.sh fixed exactly this for itself and its header
        # explains why ("--not --remotes was wrong twice over"); this copy was
        # never corrected. Same logic, deliberately, so the two cannot drift.
        #
        # When the TARGET remote has no local refs at all (never fetched, or a
        # genuine first push) there is nothing legitimately "already there", so
        # the honest answer is to scan the branch's full history rather than
        # fall back to an empty exclusion set, which reduces to the same bug.
        _known=$(git for-each-ref --format='%(refname)' "refs/remotes/$remote" 2>/dev/null \
                 | grep -v '/wip/' || true)
        if [ -n "$_known" ]; then
            # shellcheck disable=SC2086
            revs=$(git rev-list "$ls" --not $_known 2>/dev/null || true)
        else
            revs=$(git rev-list "$ls" 2>/dev/null || true)
        fi
    else
        revs=$(git rev-list "${rs}..${ls}" 2>/dev/null || true)
    fi
    while IFS= read -r c; do
        [ -n "$c" ] && COMMITS+=("$c")
    done <<<"$revs"
    i=$(( i + 1 ))
done

if [ "${#COMMITS[@]}" -eq 0 ]; then
    echo "${GREEN}${BOLD}pre-push: nothing new to scan; gates passed${RESET}"
    exit 0
fi

# ── Secret sweep across the pushed commits ──────────────────────────────────
SECRET_REGEX=(
    '-----BEGIN [A-Z ]*PRIVATE KEY-----'
    'AKIA[0-9A-Z]{16}'
    'ASIA[0-9A-Z]{16}'
    'gh[pousr]_[A-Za-z0-9]{36,}'
    'github_pat_[A-Za-z0-9_]{50,}'
    'glpat-[A-Za-z0-9_-]{20,}'
    'xox[baprs]-[A-Za-z0-9-]{10,}'
    'AIza[0-9A-Za-z_-]{35}'
    'sk-[A-Za-z0-9]{20,}'
    'sk_live_[0-9A-Za-z]{20,}'
    'whsec_[0-9A-Za-z]{20,}'
)
JOIN() { local IFS='|'; printf '%s' "$*"; }
SECRET_JOINED=$(JOIN "${SECRET_REGEX[@]}")

ALLOW_PATTERNS=()
if [ -f .baseline-hook-allow ]; then
    while IFS= read -r l; do
        [ -z "$l" ] && continue
        case "$l" in \#*) continue ;; esac
        ALLOW_PATTERNS+=("$l")
    done < .baseline-hook-allow
fi
allowlisted() {
    for p in "${ALLOW_PATTERNS[@]:-}"; do
        [ -z "$p" ] && continue
        echo "$1" | grep -qE -e "$p" && return 0
    done
    return 1
}

SECRET_HITS=()
ADDED_ALL=""
for c in "${COMMITS[@]}"; do
    added=$(git show --unified=0 --no-color --diff-filter=AM --format= "$c" 2>/dev/null \
            | grep -E '^\+' | grep -vE '^\+\+\+' || true)
    [ -z "$added" ] && continue
    ADDED_ALL+="$added"$'\n'
    while IFS= read -r line; do
        content="${line:1}"
        if echo "$content" | grep -qiE -e "$SECRET_JOINED" && ! allowlisted "$content"; then
            SECRET_HITS+=("    ${c:0:9}  ${content:0:110}")
        fi
    done <<<"$added"
done

if [ "${#SECRET_HITS[@]}" -gt 0 ]; then
    echo "${RED}${BOLD}SECRET GATE: push blocked${RESET}"
    echo "Commits in this push add lines that look like credentials:"
    printf '%s\n' "${SECRET_HITS[@]}"
    echo "Scrub them, rewrite the offending commits, and rotate the secret."
    exit 1
fi

# Deep scan with gitleaks when it is on PATH: the regex list above is the always
# on floor; gitleaks (hundreds of maintained rules + entropy) catches token
# shapes the floor misses. Absent gitleaks, the floor still stands. Disable with
# GITLEAKS_ENABLED=0. Findings redacted so no secret reaches the terminal.
if [ "${GITLEAKS_ENABLED:-1}" != "0" ] && command -v gitleaks >/dev/null 2>&1 && [ -n "$ADDED_ALL" ]; then
    if ! printf '%s' "$ADDED_ALL" | gitleaks stdin --redact >/dev/null 2>&1; then
        echo "${RED}${BOLD}SECRET GATE: push blocked (gitleaks)${RESET}"
        echo "gitleaks found credential-shaped content in the pushed commits."
        echo "Inspect with:  <the added diff> | gitleaks stdin -v"
        echo "Scrub, rewrite the offending commits, rotate the secret."
        echo "False positive: add a gitleaks allowlist, or GITLEAKS_ENABLED=0 as a last resort."
        exit 1
    fi
fi

# ── Large-file guard ────────────────────────────────────────────────────────
LARGE=()
for c in "${COMMITS[@]}"; do
    while IFS= read -r f; do
        [ -z "$f" ] && continue
        [ -f "$f" ] || continue
        sz=$(wc -c <"$f" 2>/dev/null || echo 0)
        [ "$sz" -gt 5242880 ] && LARGE+=("$f ($((sz/1024)) KB)")
    done < <(git diff-tree --no-commit-id --name-only -r "$c" 2>/dev/null || true)
done
if [ "${#LARGE[@]}" -gt 0 ] && [ -z "${BASELINE_LARGE_FILE_OK:-}" ]; then
    echo "${RED}${BOLD}LARGE-FILE GATE: push blocked${RESET}"
    printf '  %s\n' "${LARGE[@]}" | sort -u
    echo "Confirm with: ${BOLD}BASELINE_LARGE_FILE_OK=1 git push${RESET}"
    echo "Better: git-lfs, an asset store, or keep the binary out of git."
    exit 1
fi

# ── Version-consistency gate ────────────────────────────────────────────────
# If the project declares its version in multiple files (workspace crates +
# Tauri conf + frontend package.json), all of them must agree. Skips
# gracefully if the project has no version files at all.
#
# Project root config (.baseline-hook-config) can extend the discovery list:
#   VERSION_FILES=(Cargo.toml src-tauri/Cargo.toml ...)
# Default discovery: every Cargo.toml with a `[package]` block + every
# package.json + tauri.conf.json + tauri.conf.json5.
#
# Toggle the whole gate off with VERSION_DRIFT_ENABLED=0 (e.g. a repo whose
# frontend and crates version independently on purpose).
repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# Source config if present (already sourced by pre-commit; idempotent).
if [[ -f .baseline-hook-config ]]; then
    if ! load_baseline_hook_config .baseline-hook-config; then
        echo "${RED}${BOLD}REFUSED${RESET}: .baseline-hook-config has a line that is not a setting."
        echo "The baseline hooks now parse that file instead of executing it, so a"
        echo "stray command there can no longer run on your machine. Remove the lines"
        echo "named above, or express them as NAME=value / NAME=(...)."
        exit 1
    fi
fi

VERSION_DRIFT_ENABLED="${VERSION_DRIFT_ENABLED:-1}"
[[ -v VERSION_FILES ]] || VERSION_FILES=()
if [[ "$VERSION_DRIFT_ENABLED" != "0" && -z "${VERSION_FILES:-}" ]]; then
    # Auto-discover. Find Cargo.toml with a [package] block; package.json
    # with a "version" field; tauri.conf.json{,5}. Skip target/, node_modules/,
    # vendored deps.
    AUTO_VERSIONS=()
    while IFS= read -r f; do
        [[ -z "$f" ]] && continue
        case "$f" in
            */target/*|*/node_modules/*|*/vendor/*|*/private/*|*/fuzz/*) continue ;;
        esac
        if grep -qE '^\[package\]' "$f" 2>/dev/null; then
            # Skip unpublished sub-workspaces. Two conventions:
            #   (a) version = "0.0.0" (the canonical "never published" marker)
            #   (b) publish = false in the [package] block
            if grep -qE '^version[[:space:]]*=[[:space:]]*"0\.0\.0"' "$f" 2>/dev/null \
            || grep -qE '^publish[[:space:]]*=[[:space:]]*false' "$f" 2>/dev/null ; then
                continue
            fi
            AUTO_VERSIONS+=("$f")
        fi
    done < <(find . -name Cargo.toml -not -path '*/target/*' -not -path '*/node_modules/*' -not -path '*/private/*' 2>/dev/null)
    while IFS= read -r f; do
        [[ -z "$f" ]] && continue
        case "$f" in
            */target/*|*/node_modules/*|*/vendor/*|*/private/*) continue ;;
        esac
        if grep -qE '"version":' "$f" 2>/dev/null; then
            AUTO_VERSIONS+=("$f")
        fi
    done < <(find . \( -name package.json -o -name 'tauri.conf.json' -o -name 'tauri.conf.json5' -o -name composer.json \) -not -path '*/node_modules/*' -not -path '*/vendor/*' 2>/dev/null)
    VERSION_FILES=("${AUTO_VERSIONS[@]}")
fi

if [[ "$VERSION_DRIFT_ENABLED" != "0" && "${#VERSION_FILES[@]}" -gt 0 ]]; then
    declare -A SEEN_VERSIONS
    DRIFT_LIST=()
    for f in "${VERSION_FILES[@]}"; do
        [[ -f "$f" ]] || continue
        case "$f" in
            *Cargo.toml)
                v=$(awk '/^\[package\]/{flag=1; next} /^\[/{flag=0} flag && /^version[[:space:]]*=/{gsub(/[" ]/,"",$3); print $3; exit}' "$f" 2>/dev/null)
                # Fallback: first version line if package block parsing missed.
                if [[ -z "$v" ]]; then
                    v=$(grep -E '^version[[:space:]]*=' "$f" 2>/dev/null | head -1 | sed -E 's/.*"([^"]+)".*/\1/')
                fi
                ;;
            # composer.json joined this list 2026-08-11. A PHP project's
            # version lives in the same JSON shape, and an application (as
            # opposed to a library) usually omits the field entirely, so it is
            # picked up only where it exists and cannot manufacture drift.
            *package.json|*tauri.conf.json|*tauri.conf.json5|*composer.json)
                if command -v jq >/dev/null 2>&1; then
                    v=$(jq -r '.version // empty' "$f" 2>/dev/null)
                else
                    v=$(grep -E '"version":' "$f" 2>/dev/null | head -1 | sed -E 's/.*"version"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/')
                fi
                ;;
            *) continue ;;
        esac
        if [[ -n "$v" ]]; then
            SEEN_VERSIONS["$f"]="$v"
            DRIFT_LIST+=("$f=$v")
        fi
    done

    # Detect drift.
    UNIQUE_VERSIONS=$(printf '%s\n' "${SEEN_VERSIONS[@]}" | sort -u | wc -l)
    if [[ "$UNIQUE_VERSIONS" -gt 1 ]]; then
        if [[ -n "${BASELINE_VERSION_DRIFT_OK:-}" ]]; then
            echo "${YELLOW}version drift present but overridden (BASELINE_VERSION_DRIFT_OK=1):${RESET}"
            for entry in "${DRIFT_LIST[@]}"; do printf '  %s\n' "$entry"; done
        else
            echo "${RED}${BOLD}VERSION-DRIFT GATE: push blocked${RESET}"
            echo
            echo "Version declarations across the repo do not agree:"
            echo
            for entry in "${DRIFT_LIST[@]}"; do
                printf '  %s\n' "$entry"
            done
            echo
            echo "${YELLOW}Fix:${RESET} bump every declaration to the same value before pushing."
            echo "${YELLOW}Skip (override):${RESET} BASELINE_VERSION_DRIFT_OK=1 git push"
            exit 1
        fi
    fi
fi

# ── Publishable-content sweep (opt in, shares the pre-commit knobs) ─────────
# The same gate pre-commit runs, applied to the push range as well.
#
# It is not redundant with the commit-time copy, because not every commit goes
# through a hook: an autosave timer or a scripted commit that skips hooks lands
# content the commit gate never saw, and the push is then the only place it is
# ever checked. A gate that exists only on the commit path is a gate with a
# documented way around it.
#
# Reads exactly the same knobs as pre-commit, so there is one source of truth
# for what counts as publishable and what counts as an internal marker.
# `set -u` makes a bare reference to an unset array an error, and `${#a[@]:-0}`
# is not valid substitution syntax, so the arrays are defaulted explicitly.
[[ -v IP_PUBLISHABLE_PATHS[@] ]] || IP_PUBLISHABLE_PATHS=()
[[ -v IP_FORBIDDEN_REGEX[@] ]] || IP_FORBIDDEN_REGEX=()
[[ -v IP_PUBLISHABLE_LEGIT_PATTERNS[@] ]] || IP_PUBLISHABLE_LEGIT_PATTERNS=()
if [ "${IP_HYGIENE_ENABLED:-0}" = "1" ] && [ "${#IP_PUBLISHABLE_PATHS[@]}" -gt 0 ]; then
    IP_VIOLATIONS=()
    _ip_is_publishable() {
        local f="$1" prefix
        for prefix in "${IP_PUBLISHABLE_PATHS[@]}"; do
            [[ "$f" == "$prefix"* ]] && return 0
            [[ "$f" == *"/$prefix"* ]] && return 0
        done
        return 1
    }
    _ip_changed=$(printf '%s\n' "${COMMITS[@]}" | while IFS= read -r c; do
        [ -n "$c" ] && git show --pretty=format: --name-only --diff-filter=d "$c" 2>/dev/null
    done | sort -u)
    while IFS= read -r f; do
        [ -n "$f" ] || continue
        _ip_is_publishable "$f" || continue
        [ -f "$f" ] || continue
        stripped=$(cat "$f")
        for legit in "${IP_PUBLISHABLE_LEGIT_PATTERNS[@]}"; do
            [ -n "$legit" ] && stripped=$(printf '%s' "$stripped" | sed -E "s/${legit}//g")
        done
        for pattern in "${IP_FORBIDDEN_REGEX[@]}"; do
            [ -n "$pattern" ] || continue
            if printf '%s' "$stripped" | grep -qE "$pattern"; then
                sample=$(printf '%s' "$stripped" | grep -nE "$pattern" | head -1)
                IP_VIOLATIONS+=("${RED}${f}${RESET}: ${BOLD}${pattern}${RESET}")
                IP_VIOLATIONS+=("    ${sample:0:140}")
            fi
        done
    done <<<"$_ip_changed"

    if [ "${#IP_VIOLATIONS[@]}" -gt 0 ]; then
        echo
        echo "${RED}${BOLD}PUBLISHABLE-CONTENT GATE: push blocked${RESET}"
        echo
        echo "Files in the push range sit under a publishable path and carry an"
        echo "internal marker. These render publicly and would leak internal"
        echo "vocabulary or a private path."
        echo
        for v in "${IP_VIOLATIONS[@]}"; do echo "  $v"; done
        echo
        echo "${YELLOW}Either${RESET} editorially strip the marker and amend the commit,"
        echo "or, if the string is genuinely public (a licence name, a documented"
        echo "environment variable), add it to IP_PUBLISHABLE_LEGIT_PATTERNS in"
        echo ".baseline-hook-config with a comment saying why."
        echo
        exit 1
    fi
fi

# ── Invariant deterministic gate (opt in) ───────────────────────────────────
# Runs the pure-deterministic checks from the shared `invariant` crate. That
# crate already dispatches per project, so this belongs in the shared hook
# behind a knob rather than pasted into one project's copy, which is where it
# lived until 2026-07-26 and why that project's hook could not be replaced.
#
# Off by default. A project turns it on with INVARIANT_GATE_ENABLED=1 and, if
# the binary is not on PATH or at the default build location, INVARIANT_BIN.
# Skips with a note rather than refusing when the binary is absent: a missing
# build is a setup gap, not a policy violation, and refusing there would teach
# people to bypass.
if [ "${INVARIANT_GATE_ENABLED:-0}" = "1" ]; then
    _inv_repo="${INVARIANT_REPO:-$repo_root}"
    _inv_bin="${INVARIANT_BIN:-}"
    if [ -z "$_inv_bin" ]; then
        for _c in "$HOME/the-factory/hephaestus/target/release/invariant" \
                  "$(command -v invariant 2>/dev/null || true)"; do
            [ -n "$_c" ] && [ -x "$_c" ] && { _inv_bin="$_c"; break; }
        done
    fi
    if [ -n "$_inv_bin" ] && [ -x "$_inv_bin" ] && [ -d "$_inv_repo" ]; then
        echo "${BOLD}==> invariant gate-determ${RESET}"
        if ! "$_inv_bin" gate-determ --repo "$_inv_repo"; then
            echo "${RED}${BOLD}REFUSED${RESET}: ${BOLD}invariant deterministic gate failed${RESET}"
            echo "Each finding above prints file, line and context. Fix it, or if it"
            echo "is a confirmed false positive add a scoped allowlist in the matching"
            echo "check module under crates/invariant/src/checks/ with a comment"
            echo "explaining the carve-out. Never weaken the check globally."
            exit 1
        fi
    else
        echo "${YELLOW}NOTE${RESET}: invariant gate enabled but skipped (binary or repo not found)."
        echo "      Build once: cargo build --release --manifest-path \\"
        echo "        \$HOME/the-factory/hephaestus/crates/invariant/Cargo.toml"
    fi
fi
# NOTE ON ORDERING: the Rust block below exits 0 outright when the repo has
# no Cargo.toml. Anything appended after it is dead code in every non-Rust
# repo, silently, while still looking installed. Two gates were added below
# it on 2026-07-26 and never ran once. New gates go HERE, above that block.
# ── Optional Rust gates, scoped to changed files ────────────────────────────
#
# These used to `exit 0` when the repo had no Cargo.toml or no changed Rust
# files. That made every gate written below them dead code, silently, in every
# non-Rust repo, while still looking installed. It killed three: dokima's
# invariant gate from the day it was written, and two added on 2026-07-26.
# ADR 63's loophole hunt records the same shape hitting the panel-gate call.
#
# They are skips now, not exits, so the hook always reaches its end and a gate
# appended anywhere still runs. Nothing below may reintroduce a bare `exit 0`
# for a "nothing to do here" case; set a flag and guard the block instead.
RUST_GATES_APPLICABLE=1
CHANGED_RS=()

if [ ! -f "$repo_root/Cargo.toml" ]; then
    RUST_GATES_APPLICABLE=0
    # Say so. The quality half of this hook is Rust only, and until 2026-08-11
    # a repo in any other language pushed with no format, lint or test gate at
    # all, silently, while the hook printed "all gates passed". The security
    # half (secrets, private material, large files, supply chain) is language
    # agnostic and did run, so this is a narrower gap than it sounds, but a
    # silent one is exactly what this cycle is about.
    #
    # Naming the ecosystem rather than saying nothing, so the absence is a
    # visible decision rather than an accident. A dispatch table that actually
    # runs the right triple per ecosystem is the real fix and is a bigger piece
    # of work; this is the honest interim.
    if [ -f "$repo_root/composer.json" ]; then
        echo "${YELLOW}NOTE${RESET}: PHP project. Format, lint and test gates are not wired here"
        echo "      (Pint, PHPStan, PHPUnit). The security gates above did run."
    elif [ -f "$repo_root/package.json" ]; then
        echo "${YELLOW}NOTE${RESET}: JS/TS project. Format, lint and test gates are not wired here."
        echo "      The security gates above did run."
    elif [ -f "$repo_root/pyproject.toml" ] || [ -f "$repo_root/requirements.txt" ]; then
        echo "${YELLOW}NOTE${RESET}: Python project. Format, lint and test gates are not wired here."
        echo "      The security gates above did run."
    else
        echo "${YELLOW}NOTE${RESET}: no recognised build manifest, so no quality gate ran."
        echo "      The security gates above did run."
    fi
else
    for c in "${COMMITS[@]}"; do
        while IFS= read -r f; do
            [ -z "$f" ] && continue
            case "$f" in *.rs) [ -f "$f" ] && CHANGED_RS+=("$f") ;; esac
        done < <(git diff-tree --no-commit-id --name-only -r "$c" 2>/dev/null || true)
    done
    if [ "${#CHANGED_RS[@]}" -eq 0 ]; then
        RUST_GATES_APPLICABLE=0
    else
        mapfile -t CHANGED_RS < <(printf '%s\n' "${CHANGED_RS[@]}" | sort -u)
    fi
fi

if [ "$RUST_GATES_APPLICABLE" = "1" ]; then

echo "${BOLD}==> cargo fmt --all --check (${#CHANGED_RS[@]} Rust file(s) changed)${RESET}"
# Use `cargo fmt` rather than per-file `rustfmt` so the workspace's
# declared edition (Cargo.toml's edition = "2024" et al.) is honoured.
# Per-file `rustfmt --edition X` hardcoding desynchronises whenever a
# project bumps its edition (e.g. 2021 → 2024).
if ! cargo fmt --all -- --check; then
    echo "${RED}${BOLD}REFUSED${RESET}: cargo fmt --check failed."
    exit 1
fi

# Clippy scope: defaults to whole workspace via --all-targets. A
# project with system-dep-heavy crates (Tauri's libsoup, GTK, etc.)
# can scope clippy to the changed-frequently subset by setting
# CLIPPY_PACKAGES in .baseline-hook-config:
#   CLIPPY_PACKAGES='-p stegcore-engine -p stegcore-core -p stegcore-cli'
# CLIPPY_ENABLED=0 turns the local clippy gate off entirely (fmt, the secret
# sweep, and the branch/size/version gates all still run). Use this on a big
# workspace whose clippy compile would exhaust the machine you push from (e.g. a
# low-RAM laptop pushing a heavy tree); CI still enforces clippy on the merge
# commit, so nothing is lost, the check just moves off the local box.
CLIPPY_ENABLED="${CLIPPY_ENABLED:-1}"
CLIPPY_PACKAGES="${CLIPPY_PACKAGES:-}"
if [ "$CLIPPY_ENABLED" = "0" ]; then
    echo "${YELLOW}==> cargo clippy skipped locally (CLIPPY_ENABLED=0; CI enforces it)${RESET}"
else
    echo "${BOLD}==> cargo clippy ${CLIPPY_PACKAGES} --all-targets -- -D warnings${RESET}"
    # shellcheck disable=SC2086
    if ! cargo clippy $CLIPPY_PACKAGES --all-targets -- -D warnings; then
        echo "${RED}${BOLD}REFUSED${RESET}: cargo clippy failed."
        exit 1
    fi
fi
fi   # end RUST_GATES_APPLICABLE

echo "${GREEN}${BOLD}pre-push: all gates passed${RESET}"
exit 0
