#!/usr/bin/env bash
#
# commit-msg: commit message discipline.
#
# Blocks:
#   1. Co-author trailers. The author is the author; tools are tools.
#   2. AI-attribution boilerplate ("Generated with ...", tool footers,
#      the robot emoji, "AI-assisted", and the wider set).
#   3. Bypass markers in the message text ("no-verify", "skip hooks").
#      If --no-verify was used this hook does not run, but the marker
#      sitting in the message is a smell and is blocked.
#
# Implements Section 8 of the engineering baseline.
#
# Hyphens are NOT checked here: the no-hyphen rule targets user-facing
# strings, and a commit message is git metadata, not user-facing copy.

set -eu

MSG_FILE="$1"
MSG=$(cat "$MSG_FILE")

RED=$(tput setaf 1 2>/dev/null || true)
BOLD=$(tput bold 2>/dev/null || true)
RESET=$(tput sgr0 2>/dev/null || true)

FAIL=0

# 1. Co-author trailers and AI-attribution boilerplate: NO LONGER CHECKED.
#
# Withdrawn by operator decision, 2026-07-28. The rule forbade `Co-Authored-By`
# lines, the Claude Code footer, and any "AI-assisted" phrasing, on the reasoning
# that attribution invited a reader to discount the work. The operator's judgement
# is that this has stopped being true: leveraging a model is now an ordinary part
# of how work gets done, and hiding it is the part that reads oddly.
#
# Nothing replaces it. Attribute or do not; neither is a gate's business.
#
# The hyphen and bypass-marker checks below are unaffected: those are about what
# the message SAYS, not about who helped write the change.

# 2. Bypass markers in the message.
if echo "$MSG" | grep -qiE '(no[- ]verify|skip[- ]hooks|bypass[- ]gate)'; then
    echo
    echo "${RED}${BOLD}COMMIT-MSG GATE: bypass marker in message${RESET}"
    echo "  Strip the bypass marker from the commit text."
    FAIL=1
fi

[[ $FAIL -eq 1 ]] && { echo; exit 1; }
exit 0
